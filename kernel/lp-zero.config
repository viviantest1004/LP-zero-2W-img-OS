# lp-zero.config - bcm2711_defconfig 위에 덮어쓰는 설정 조각.
#
# scripts/kconfig/merge_config.sh 로 병합한다. 여기 없는 옵션은
# defconfig 값을 그대로 쓴다.
#
# 원칙: 하드웨어가 정해져 있으므로 실제로 쓰는 것만 켠다.
# 범용 배포판은 "무엇이 꽂힐지 모른다"는 전제로 다 넣지만 우리는 안다.

# ── 모듈 지원을 통째로 끈다 ─────────────────────────────────────
# 이 한 줄이 defconfig 의 모듈 1,325개를 전부 없앤다.
# /lib/modules 도, modprobe 도, 모듈 로딩/서명 코드도 사라진다.
CONFIG_MODULES=n

# ── initramfs (우리 루트) ───────────────────────────────────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# INITRAMFS_SOURCE 는 build.sh 가 채운다 (경로가 환경마다 다르므로)
CONFIG_INITRAMFS_COMPRESSION_GZIP=y

# ── 필수 파일시스템 ─────────────────────────────────────────────
# 가상 파일시스템 - 커널이 만들어낸다. 빼면 부팅 자체가 안 된다.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# 디스크 파일시스템 - 실제로 쓰는 둘만
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# 안 쓰는 디스크/네트워크 파일시스템
CONFIG_BTRFS_FS=n
CONFIG_XFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_JFS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_NTFS3_FS=n
CONFIG_HFS_FS=n
CONFIG_HFSPLUS_FS=n
CONFIG_UDF_FS=n
CONFIG_ISO9660_FS=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n
CONFIG_CIFS=n
CONFIG_CEPH_FS=n
CONFIG_9P_FS=n
CONFIG_ORANGEFS_FS=n
CONFIG_GFS2_FS=n
CONFIG_OCFS2_FS=n
CONFIG_MINIX_FS=n
CONFIG_ROMFS_FS=n
CONFIG_UBIFS_FS=n
CONFIG_QUOTA=n

# ── 시리얼 콘솔 ─────────────────────────────────────────────────
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=n

# ── SD / MMC (데이터 파티션) ────────────────────────────────────
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_MMC_BCM2835=y

# ── 네트워크: IPv4 만 ───────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IPV6=n
CONFIG_NETFILTER=n
CONFIG_BRIDGE=n
CONFIG_VLAN_8021Q=n
CONFIG_IP_MULTICAST=n
CONFIG_IP_ADVANCED_ROUTER=n
CONFIG_NET_SCHED=n
CONFIG_CAN=n
CONFIG_TIPC=n
CONFIG_IP_SCTP=n
CONFIG_L2TP=n
CONFIG_MPLS=n
CONFIG_BT=n

# ── 사운드 (안 씀) ──────────────────────────────────────────────
CONFIG_SOUND=n
CONFIG_SND=n

# ── 미디어 / 카메라 (안 씀) ─────────────────────────────────────
CONFIG_MEDIA_SUPPORT=n

# ── 입력 장치: USB 키보드만 나중에. 지금은 전부 끈다 ────────────
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_MISC=n

# ── 산업용 센서 / 하드웨어 모니터 ───────────────────────────────
CONFIG_IIO=n
CONFIG_HWMON=n
CONFIG_W1=n

# ── 가상화 ──────────────────────────────────────────────────────
CONFIG_VIRTUALIZATION=n
CONFIG_KVM=n

# ── 디버그 / 트레이싱 (이미지 크기를 크게 먹는다) ───────────────
CONFIG_DEBUG_INFO_NONE=y
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_PROFILING=n
CONFIG_KALLSYMS_ALL=n
CONFIG_DEBUG_KERNEL=n
CONFIG_MAGIC_SYSRQ=n

# ── 기타 ────────────────────────────────────────────────────────
CONFIG_SWAP=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_AIO=n
CONFIG_IO_URING=n

# 기본 커널 커맨드라인.
# 실기에서는 cmdline.txt 가 덮어쓰지만, 없을 때의 안전한 기본값이다.
CONFIG_CMDLINE="console=ttyAMA0,115200 console=tty1 rootwait"
