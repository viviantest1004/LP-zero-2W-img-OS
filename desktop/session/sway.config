# ~/.config/sway/config
#
# 창 모양은 목업이 정하고, 단축키는 명세서 5-9 가 정한다. 여기 있는
# 것 중 이 파일이 스스로 정한 값은 하나도 없다.

# ── 창 ────────────────────────────────────────────────────────────
#
# The window mockup is floating windows that overlap, each drawing its own
# header bar. So: nothing tiles, and sway draws no decoration of its own -
# a second title bar above an application's header bar would be the
# ugliest thing on the screen.
for_window [app_id=".*"] floating enable
for_window [class=".*"]  floating enable
default_border none
default_floating_border none
titlebar_padding 1
gaps inner 0

# The desktop, from the design system.
output * bg #0e0e0e solid_color

# 상단바가 30px 이라 창이 그 아래에서 시작해야 한다. 겹치면 창의 헤더
# 바를 잡을 수 없다.
gaps top 30

# 퀵메뉴. 레이어 셸이 아니라 보통 창이라서, 다른 창처럼 다뤄지지
# 않도록 여기서 따로 말해 준다: 테두리 없음, 모든 작업공간에 따라옴,
# 크기는 자기가 정한 320px 그대로.
for_window [app_id="org.lpzero.QuickMenu"] floating enable, border none, sticky enable

set $mod Mod4

# ── 5-9 단축키 ────────────────────────────────────────────────────

# 검색 열기. 명세서 4-1 이 정한 키이고, 런처의 유일한 진입점이 아니다 -
# 상단바 왼쪽의 '검색' 글자를 눌러도 같은 것이 뜬다 (4-2 의 첫 번째 조건,
# "진입점이 화면에 보인다").
bindsym Ctrl+space exec /usr/bin/fuzzel

# 터미널과 파일 관리자
bindsym $mod+t exec /usr/bin/foot
bindsym $mod+Return exec /usr/bin/foot
bindsym $mod+e exec /usr/local/bin/lp-files
bindsym $mod+i exec /usr/local/bin/lp-settings
# 윈도우와 같은 자리에 둔다. 작업 관리자를 찾는 사람은 대개 이미
# 무언가가 멈춘 뒤이고, 그때 런처를 열어 이름을 칠 여유가 없다.
bindsym Ctrl+Shift+Escape exec /usr/local/bin/lp-tasks
# 퀵메뉴. 상단바의 상태 아이콘을 눌러도 같은 것이 뜬다.
bindsym $mod+n exec /usr/local/bin/lp-quick

# 창
bindsym $mod+q kill
bindsym Alt+F4 kill
bindsym $mod+Up fullscreen toggle
bindsym Alt+Tab focus next
bindsym Alt+Shift+Tab focus prev

# 반쪽 스냅
bindsym $mod+Left  resize set width 50ppt height 100ppt, move position 0 30
bindsym $mod+Right resize set width 50ppt height 100ppt, move position 50ppt 30

# 화면 잠금
bindsym $mod+l exec /usr/bin/swaylock -f -c 0e0e0e

# 스크린샷. 명세서는 이것을 앱이 아니라 셸에 넣으라고 했고, 여기가
# 그 셸이다. grim 이 화면을 잡고 wl-copy 가 클립보드에 넣는다 -
# 파일로만 저장하면 붙여넣기까지 한 단계가 더 필요하다.
bindsym Print       exec grim - | wl-copy
bindsym Shift+Print exec grim -g "$(slurp)" - | wl-copy
bindsym Alt+Print   exec grim -g "$(swaymsg -t get_tree | grep -o '\"rect\":[^}]*}' | head -1)" - | wl-copy
# 창이 있는 스크린샷 앱. 지연을 주거나, 찍고 나서 그림판으로 이어
# 그리려면 이쪽이다. 즉시 찍는 위의 셋과 겹치지 않는다.
bindsym Ctrl+Shift+Print exec /usr/local/bin/lp-shot

# 볼륨과 밝기. 노트북 키보드의 미디어 키가 그대로 동작해야 한다.
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute     exec wpctl set-mute   @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# 작업공간. 명세서 5-8 의 상한이 20 이므로 열 개까지만 키에 걸고
# 나머지는 레일을 눌러서 간다.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

bindsym $mod+Shift+e exit
floating_modifier $mod normal

input * {
    xkb_layout us
    xkb_options grp:alt_shift_toggle
}

# 설정 앱이 키보드 배열을 바꾸면 이 파일에 적는다. 위의 기본값 뒤에
# 오므로, 있으면 이쪽이 이긴다. mkdesktop 이 빈 파일을 미리 만들어
# 둔다 - sway 는 없는 파일을 include 하면 오류를 찍는다.
include ~/.config/sway/input.conf

# ── 로그인할 때 시작하는 것 ───────────────────────────────────────

# 소리. 셋을 한꺼번에 띄우면 wireplumber 가 pipewire 보다 먼저 떠서
# 붙을 데를 찾지 못하고 죽는다 - 그러면 /dev/snd 에 카드가 있는데도
# 소리 장치가 하나도 없는 상태가 된다. 순서를 지키는 것이 이 스크립트가
# 하는 일의 전부다.
exec /usr/local/bin/lp-audio-start

# 파일 선택 대화상자와 화면 공유. 앱이 "파일 열기" 를 눌렀을 때
# 실제로 창이 뜨는 것은 이 둘이 있어서다.
exec /usr/libexec/xdg-desktop-portal-wlr
exec /usr/libexec/xdg-desktop-portal

# 알림. 이것이 없으면 notify-send 도 앱의 알림도 아무 데도 나타나지
# 않고, 퀵메뉴의 '방해 금지' 도 막을 것이 없어진다.
exec /usr/bin/mako

# 상단바.
exec /usr/bin/waybar

# 화면 끄기. 몇 분 뒤에 끌지는 설정 앱이 ~/.config/lp/idle 에 적어
# 두고, 이 스크립트가 그 값으로 swayidle 을 띄운다.
exec /usr/local/bin/lp-idle
