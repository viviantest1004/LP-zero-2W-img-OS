# lp-zero.config - bcm2711_defconfig 위에 덮어쓰는 설정 조각.
#
# scripts/kconfig/merge_config.sh 로 병합한다. 여기 없는 옵션은
# defconfig 값을 그대로 쓴다.
#
# 원칙: 하드웨어가 정해져 있으므로 실제로 쓰는 것만 켠다.
# 범용 배포판은 "무엇이 꽂힐지 모른다"는 전제로 다 넣지만 우리는 안다.

# ── 모듈 지원을 통째로 끈다 ─────────────────────────────────────
# 이 한 줄이 defconfig 의 모듈 1,325개를 전부 없앤다.
# /lib/modules 도, modprobe 도, 모듈 로딩/서명 코드도 사라진다.
CONFIG_MODULES=n

# ── initramfs (우리 루트) ───────────────────────────────────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# INITRAMFS_SOURCE 는 build.sh 가 채운다 (경로가 환경마다 다르므로)
CONFIG_INITRAMFS_COMPRESSION_GZIP=y

# ── 필수 파일시스템 ─────────────────────────────────────────────
# 가상 파일시스템 - 커널이 만들어낸다. 빼면 부팅 자체가 안 된다.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# 디스크 파일시스템 - 실제로 쓰는 둘만
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# 안 쓰는 디스크/네트워크 파일시스템
CONFIG_BTRFS_FS=n
CONFIG_XFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_JFS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_NTFS3_FS=n
CONFIG_HFS_FS=n
CONFIG_HFSPLUS_FS=n
CONFIG_UDF_FS=n
CONFIG_ISO9660_FS=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n
CONFIG_CIFS=n
CONFIG_CEPH_FS=n
CONFIG_9P_FS=n
CONFIG_ORANGEFS_FS=n
CONFIG_GFS2_FS=n
CONFIG_OCFS2_FS=n
CONFIG_MINIX_FS=n
CONFIG_ROMFS_FS=n
CONFIG_UBIFS_FS=n
CONFIG_QUOTA=n

# ── 시리얼 콘솔 ─────────────────────────────────────────────────
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=n

# ── SD / MMC (데이터 파티션) ────────────────────────────────────
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_MMC_BCM2835=y

# ── 네트워크: IPv4 만 ───────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IPV6=n
CONFIG_NETFILTER=n
CONFIG_BRIDGE=n
CONFIG_VLAN_8021Q=n
CONFIG_IP_MULTICAST=n
CONFIG_IP_ADVANCED_ROUTER=n
CONFIG_NET_SCHED=n
CONFIG_CAN=n
CONFIG_TIPC=n
CONFIG_IP_SCTP=n
CONFIG_L2TP=n
CONFIG_MPLS=n
CONFIG_BT=n

# ── 사운드 (안 씀) ──────────────────────────────────────────────
CONFIG_SOUND=n
CONFIG_SND=n

# ── 미디어 / 카메라 (안 씀) ─────────────────────────────────────
CONFIG_MEDIA_SUPPORT=n

# ── 입력 장치: USB 키보드만 나중에. 지금은 전부 끈다 ────────────
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_MISC=n

# ── 산업용 센서 / 하드웨어 모니터 ───────────────────────────────
CONFIG_IIO=n
CONFIG_HWMON=n
CONFIG_W1=n

# ── 가상화 ──────────────────────────────────────────────────────
CONFIG_VIRTUALIZATION=n
CONFIG_KVM=n

# ── 디버그 / 트레이싱 (이미지 크기를 크게 먹는다) ───────────────
CONFIG_DEBUG_INFO_NONE=y
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_PROFILING=n
CONFIG_KALLSYMS_ALL=n
CONFIG_DEBUG_KERNEL=n
CONFIG_MAGIC_SYSRQ=n

# ── 기타 ────────────────────────────────────────────────────────
CONFIG_SWAP=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_AIO=n
CONFIG_IO_URING=n


# ═══════════════════════════════════════════════════════════════
# 2차: 서브시스템 통째로 끄기
#
# CONFIG_MODULES=n 만으로는 부족하다. 모듈이던 옵션 중 상당수를
# olddefconfig 가 빌트인(=y)으로 승격시키기 때문이다 (=m 이 유효하지
# 않으니 기본값으로 되돌아가는데, 그 기본값이 y 인 경우가 많다).
# 실제로 1차에서 =y 가 1,895 -> 2,426 으로 늘었다.
# 그래서 서브시스템 루트 옵션을 직접 꺼야 한다.
# ═══════════════════════════════════════════════════════════════

# ── USB 통째로 ─────────────────────────────────────────────────
# Zero 2 W 의 WiFi 는 SDIO 로 붙는다. USB 가 전혀 필요 없다.
# (나중에 USB 키보드를 쓰려면 이 줄만 되돌리면 된다)
CONFIG_USB_SUPPORT=n

# ── 이더넷 ─────────────────────────────────────────────────────
# Zero 2 W 에는 이더넷 포트가 없다.
CONFIG_ETHERNET=n
CONFIG_PHYLIB=n

# ── 무선: 우리 칩만 ────────────────────────────────────────────
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y

# 나머지 벤더는 전부 끈다
CONFIG_WLAN_VENDOR_ADMTEK=n
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_CISCO=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_MICROCHIP=n
CONFIG_WLAN_VENDOR_PURELIFI=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_REALTEK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_SILABS=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_QUANTENNA=n

# ── 그래픽: 1단계는 시리얼 콘솔만 ──────────────────────────────
# 프레임버퍼 콘솔은 부팅이 확인된 뒤 2단계에서 켠다.
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_BACKLIGHT_CLASS_DEVICE=n
CONFIG_LOGO=n

# ── 입력 장치 / HID ────────────────────────────────────────────
# 키보드를 붙일 때 되돌린다.
CONFIG_HID_SUPPORT=n

# ── 버스: 지금은 안 쓴다 ───────────────────────────────────────
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_MTD=n

# ── 블록 계층 부가 기능 ────────────────────────────────────────
CONFIG_MD=n
CONFIG_BLK_DEV_DRBD=n
CONFIG_STAGING=n
CONFIG_NFC=n

# 기본 커널 커맨드라인.
# 실기에서는 cmdline.txt 가 덮어쓴다. 여기 값은 없을 때의 기본값이다.
# 프레임버퍼를 켜기 전이므로 시리얼 콘솔만 지정한다.
CONFIG_CMDLINE="console=ttyAMA0,115200 rootwait"

# ── 부팅 로그에서 실제로 확인된 불필요 항목 ────────────────────
# 1차 빌드 로그에 이것들이 전부 올라왔다. 승격된 모듈들이다.
CONFIG_CEPH_LIB=n
CONFIG_BATMAN_ADV=n
CONFIG_OPENVSWITCH=n
CONFIG_VSOCKETS=n
CONFIG_NETCONSOLE=n
CONFIG_NET_9P=n
CONFIG_ATM=n
CONFIG_6LOWPAN=n
CONFIG_IEEE802154=n
CONFIG_MAC802154=n
CONFIG_CAIF=n
CONFIG_RDS=n
CONFIG_HSR=n
CONFIG_NET_DSA=n
CONFIG_AF_KCM=n
CONFIG_SMC=n
CONFIG_XDP_SOCKETS=n
CONFIG_BPF_SYSCALL=n
CONFIG_WIRELESS_HOTKEY=n
CONFIG_SYSTEM_TRUSTED_KEYRING=n
CONFIG_MODULE_SIG=n

# ═══════════════════════════════════════════════════════════════
# 3차: 실제 크기 측정으로 찾아낸 것들
#
# 2차 빌드(20.2MB)의 vmlinux 를 뜯어 남아 있는 큰 덩어리를 확인했다.
# 설정에 명시하지 않아 defconfig 값이 그대로 살아 있던 것들이다.
# ═══════════════════════════════════════════════════════════════

# bcachefs - 신형 파일시스템. 오브젝트만 2.4MB 다.
CONFIG_BCACHEFS_FS=n
CONFIG_FUSE_FS=n
CONFIG_ZRAM=n

# 보안 모듈 프레임워크. AppArmor 는 크고, 우리 시스템에는 사용자가
# 하나뿐이라 강제접근제어를 쓸 일이 없다.
CONFIG_SECURITY=n
CONFIG_SECURITY_APPARMOR=n
CONFIG_AUDIT=n

# PCI - Zero 2 W 에는 PCI 버스가 없다.
# (defconfig 가 Pi 4 의 PCIe 때문에 켜둔 것)
CONFIG_PCI=n

# SCSI - USB 저장장치를 껐으므로 쓸 곳이 없다.
# MMC 블록 장치는 SCSI 계층을 거치지 않는다.
CONFIG_SCSI=n
CONFIG_BLK_DEV_BSG=n

# 컨테이너 관련. 우리는 프로세스가 열 개 남짓이고 격리가 필요 없다.
CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n

# IPsec / 터널링 - 쓰지 않는다
CONFIG_XFRM_USER=n
CONFIG_INET_ESP=n
CONFIG_INET_AH=n
CONFIG_INET_IPCOMP=n
CONFIG_NET_IPGRE_DEMUX=n
CONFIG_NET_IPGRE=n
CONFIG_NET_IPIP=n

# 압축 알고리즘 - initramfs 는 gzip 을 쓴다
CONFIG_ZSTD_COMPRESS=n
CONFIG_LZ4_COMPRESS=n
