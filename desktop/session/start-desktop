#!/bin/sh
# Bring the desktop up. /etc/rc runs this once the system is otherwise up.
#
# ── Why this does not run as root ──
#
# sway refuses to start as root, and it is right to: a compositor holds
# every keystroke on the machine. So there is an ordinary account, uid
# 1000, and dropprivs hands the session to it.
#
# What logind would normally do and nothing here does: hand that account
# the graphics card and the input devices. There is no logind, so the
# permissions are set here, once, on the devices that exist.
mkdir -p /run/user/1000
chown 1000:1000 /run/user/1000
chmod 700 /run/user/1000
mkdir -p /data/log
chmod 0666 /dev/dri/card0 /dev/dri/renderD128 2>/dev/null
chmod 0666 /dev/input/event0 /dev/input/event1 /dev/input/event2 2>/dev/null
chmod 0666 /dev/input/event3 /dev/input/event4 /dev/input/event5 2>/dev/null
chmod 0666 /dev/tty0 /dev/tty1 /dev/tty2 2>/dev/null
dropprivs 1000:1000 /bin/session-run
