# /etc/rc - 부팅 스크립트. init 이 대화형 셸을 띄우기 전에 실행한다.
#
# 우리 셸이 실행한다. 변수 확장이나 if 는 없지만 && || ; 는 되므로
# 실패해도 부팅이 멈추지 않도록 폴백을 붙여 쓴다.

echo "[rc] 메모리 안전장치"
# RAM 안에 압축 스왑을 만든다. SD 에는 쓰지 않는다.
# 256MB 를 잡지만 실제로 쓰는 만큼만 RAM 을 차지한다.
zram on 256 || echo "[rc]   zram 없이 계속합니다"
# 여유가 32MB 아래로 떨어지면 가장 큰 프로세스를 정리한다.
# init/셸/SSH/무선은 보호 대상이라 죽이지 않는다.
memwatch -d -r 32 -w 64 || echo "[rc]   memwatch 시작 실패"

echo "[rc] 데이터 파티션 확장 확인"
# 이미지가 256MB 라 큰 카드에 구우면 나머지가 미할당으로 남는다.
# 첫 부팅에 파티션과 파일시스템을 카드 끝까지 늘린다.
# 이미 최대면 아무것도 하지 않고 넘어간다.
expandfs || echo "[rc]   확장 없음"

echo "[rc] 데이터 파티션 마운트"
mount /dev/mmcblk0p2 /data || echo "[rc]   없음 - 내장 설정으로 진행합니다"

echo "[rc] 무선 설정 준비"
# 데이터 파티션의 설정을 우선한다. SD 를 다시 굽지 않고 공유기 정보를
# 바꿀 수 있기 때문이다. 없으면 이미지에 내장된 것을 쓴다.
cat /data/wpa_supplicant.conf > /etc/wpa.conf || cat /etc/wpa_supplicant.conf > /etc/wpa.conf

echo "[rc] 무선 인터페이스 시작"
wpa_supplicant -B -i wlan0 -c /etc/wpa.conf || echo "[rc]   실패 - 무선 없이 계속합니다"

echo "[rc] DHCP 로 주소 요청"
dhcp wlan0 || echo "[rc]   주소를 받지 못했습니다"

echo "[rc] SSH 서버 시작"
# 호스트 키를 데이터 파티션에 두어야 재부팅해도 유지된다.
# RAM 에 두면 매번 새로 생겨서 접속할 때마다 클라이언트가 경고한다.
dropbear -R -E -p 22 -r /data/dropbear_ed25519_host_key || dropbear -R -E -p 22 || echo "[rc]   SSH 시작 실패"

echo "[rc] 완료"
