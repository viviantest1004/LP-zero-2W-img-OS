# /etc/xdg/xdg-desktop-portal-wlr/config - screen sharing under both
# compositors (wayfire and sway are both wlroots).
#
# Which screen to share is asked in a window (lp-screen-share): the
# portal's default asked through slurp, a bare crosshair that said
# nothing, and sharing looked as if it had hung.
[screencast]
chooser_type=dmenu
chooser_cmd=/usr/local/bin/lp-screen-share
