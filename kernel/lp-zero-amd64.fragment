# lp-zero-amd64.fragment - what an ordinary PC needs that a Pi does not.
#
# This is the only file to edit for the amd64 kernel. It is merged LAST,
# after the arm64 answers, so everything here wins without a list of
# exceptions to keep in step. Maintaining that list by hand went wrong
# three times - no console, no graphics, no sound - each time because a
# line that is right for a Raspberry Pi was read after the line that was
# right here.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_MICROCODE=y
CONFIG_X86_MCE=y
CONFIG_ACPI=y
CONFIG_PM=y

# ── boot ──
# One bzImage with the EFI stub inside it, so "copy it to EFI/BOOT" is
# the whole story on a PC and in a VM alike. tty0 first and ttyS0 last:
# printk goes to every console listed, but /dev/console - where init
# puts the login shell - is the last one, and a VM run headless has no
# screen to put it on.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_RELOCATABLE=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty0 console=ttyS0,115200"

# ── console ──
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# ── storage ──
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y

# ── virtual machines ──
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VMWARE_VMCI=y
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y

# ── network ──
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_8139CP=y
CONFIG_IGB=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y

# ── USB ──
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y

# ── randomness ──
# getrandom() feeds the update signature check and the DNS resolver.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_HW_RANDOM_INTEL=y
CONFIG_RANDOM_TRUST_CPU=y

# ── graphics ──
#
# DRM is on, and it has to be: anything that draws - X11, Wayland, a
# toolkit - opens /dev/dri, not a framebuffer. Without it this machine
# has a text console and no UI package can ever work on top of it.
#
# It was off for two commits because of a build failure I took the cheap
# way out of. backlight_set_display_name() is defined inside #ifdef
# CONFIG_OF in drivers/video/backlight/backlight.c but declared in the
# header under CONFIG_BACKLIGHT_CLASS_DEVICE alone, so on a machine with
# no device tree - every PC - DRM's panel bridge calls a function nobody
# compiled, and vmlinux fails to link naming neither option. Turning DRM
# off made the error go away and took the graphics with it.
#
# The fix is one line. CONFIG_OF is selectable on x86 for this kind of
# reason, it costs a few kilobytes that never run where no device tree
# is passed, and the symbol exists again.
CONFIG_OF=y
CONFIG_DRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_FBDEV_EMULATION=y

# simpledrm is the one that matters most: it drives the EFI framebuffer
# on hardware we have no specific driver for, which is the case that
# must not be a black screen. Then the VM drivers, then Intel, which is
# most real laptops.
#
# amdgpu and nouveau are deliberately absent. Each is larger than this
# whole kernel and both need firmware blobs that are not here, so they
# would add megabytes to every download for a card that still would not
# light up.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_QXL=y
CONFIG_DRM_I915=y

CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# ── what a UI needs besides pixels ──
#
# X11 has used SysV shared memory for local clients since the 1980s and
# still does; without it every image goes over the socket instead, if it
# starts at all. Wayland compositors want a real tmpfs for their buffers.
CONFIG_SYSVIPC=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SHMEM=y

# ── input ──
# A keyboard and a pointer from all three places they arrive: the PS/2
# controller a VM emulates, USB, and the absolute pointer QEMU and
# VMware use so the mouse is not trapped inside the window.
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y

# ── sound ──
# A desktop with no audio device is a bug report waiting to happen. HDA
# covers real machines and QEMU's intel-hda; virtio-snd covers the rest.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_VIRTIO=y
CONFIG_SND_USB_AUDIO=y
