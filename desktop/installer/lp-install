#!/usr/bin/python3
"""lp-install - put the running LP system onto another disk, for good.

The USB stick this OS is written to boots a real, disk-rooted system: ext4
on the stick, read-write, nothing in RAM. Installing is therefore not
"unpack an archive somewhere" but "make another copy of exactly this
system on the laptop's NVMe and make the firmware boot it". This program
does that, and the installer window (lp-installer) is a face on it: every
decision and every write is here, so the same install can be run from a
serial console, from a script in a test, or by a person at a terminal.

    lp-install list  [--json]        the disks, and which could take LP
    lp-install check [--json]        firmware facts that stop an install
    lp-install install --disk /dev/nvme0n1 [--yes] [--progress]
                       [--lang ko_KR.UTF-8] [--no-boot-entry]

What an install writes (the disk layout contract, COMMON.md):

    GPT   1  LP-ESP       FAT32   512 MiB   the kernel, the boot menu
          2  LP-RECOVERY  ext4      6 GiB   the recovery system
          3  LP-ROOT      ext4      rest    this system, copied

Why it is built the way it is:

  - It refuses the disk it is running from, and any disk with anything
    mounted, swapped on or held by device-mapper. Those are the two ways
    an installer destroys the system it is running on, and both can be
    told from /proc and /sys before a single byte is written.

  - The root is copied from the running system with rsync -aHAX: owners
    and modes, hard links (a Debian root has hundreds), ACLs, extended
    attributes (file capabilities live there - ping loses its right to
    open a raw socket without them), symlinks and device nodes. -x keeps
    it on the root filesystem, so /proc, /sys, /dev, /tmp and the stick's
    own EFI partition are not walked into.

  - Every partition gets a fresh GUID (sfdisk makes them), so the
    installed root's PARTUUID is its own and preinit can tell it from
    the stick's when both are plugged in - which is the normal state of
    affairs at the first reboot.

  - The firmware boot entry is written straight into efivarfs rather than
    through efibootmgr: it is forty lines of struct packing, and a tool
    that is not on the stick is a boot entry that is not written. The
    removable-media path \\EFI\\BOOT\\BOOTX64.EFI is always written too,
    because firmware forgets its entries (a BIOS update, a CMOS reset)
    and a disk that boots only through NVRAM does not survive that.

  - The copy is made to look like a machine nobody has used yet: no
    machine-id, no SSH host key, no installer marker. /etc/rc makes the
    first two on the first boot; the first-boot setup (lp-firstboot)
    runs once because the installer leaves /etc/lp/firstboot behind.

  - Two firmware settings on the Dell XPS 15 9550 stop an install before
    it starts, and neither can be changed from here: Secure Boot (the
    kernel is not signed by Microsoft, so an installed copy would not
    start) and SATA Operation = RAID On (the NVMe is behind Intel RST and
    Linux does not see it at all). Both are detected and explained.

Every Debian tool is called by its /usr path. /bin on this system is our
own userland (mount, blkid, sync ... are ours there and take different
options), and the tools below are the Debian ones this program was
written against.
"""

import argparse
import errno
import fcntl
import json
import os
import re
import shutil
import stat
import struct
import subprocess
import sys
import time
import uuid

ESP_MIB = 512
RECOVERY_MIB = 6 * 1024
# Room the installed root needs beyond what is on the stick today: apt
# downloads, a few updates, the first person's files. Below this the
# install would succeed and the machine would be full a week later.
ROOT_SLACK = 4 * 1024 ** 3

TYPE_ESP = "C12A7328-F81F-11D2-BA4B-00A0C93EC93B"
TYPE_LINUX = "0FC63DAF-8483-4772-8E79-3D69D8477DE4"
TYPE_ROOT_X86_64 = "4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709"

EFI_GLOBAL = "8be4df61-93ca-11d2-aa0d-00e098032b8c"
EFIVARS = "/sys/firmware/efi/efivars"
WORK = "/run/lp-install"

# The FAT label stays LPZERO: /etc/rc mounts /boot by that label on every
# LP image. The GPT names are the layout contract's.
ESP_FS_LABEL = "LPZERO"

# What the running root holds that is not the system: the kernel's own
# filesystems, scratch space, mount points, the stick's EFI partition
# (copied separately, into the new one), and caches that are rebuilt.
EXCLUDES = [
    "/proc/*", "/sys/*", "/dev/*", "/run/*", "/tmp/*", "/var/tmp/*",
    "/mnt/*", "/media/*", "/boot/*", "/lost+found",
    "/var/cache/apt/archives/*.deb", "/var/cache/apt/*.bin",
    "/swapfile",
]

PROGRESS = False


# ── small pieces ──────────────────────────────────────────────────────

class Refused(Exception):
    """An install that must not go ahead, with the reason for a person."""

    def __init__(self, key, message):
        super().__init__(message)
        self.key = key


def tool(name):
    """A Debian tool by its real path, never our /bin namesake."""
    for d in ("/usr/sbin", "/usr/bin", "/sbin", "/bin"):
        p = os.path.join(d, name)
        if os.access(p, os.X_OK):
            return p
    raise Refused("missing-tool", "%s is not installed" % name)


def run(argv, **kw):
    """Run a command; its failure is the install's failure, with its words."""
    kw.setdefault("stdout", subprocess.PIPE)
    kw.setdefault("stderr", subprocess.PIPE)
    r = subprocess.run(argv, text=True, **kw)
    if r.returncode != 0:
        msg = (r.stderr or r.stdout or "").strip().splitlines()
        raise RuntimeError("%s failed (%d): %s" % (
            os.path.basename(argv[0]), r.returncode, msg[-1] if msg else ""))
    return r.stdout or ""


def say(kind, *words):
    """One line for the window (with --progress) or for a person."""
    if PROGRESS:
        print(kind, *words, flush=True)
    elif kind in ("STEP", "ERROR", "DONE", "NOTE"):
        print(" ".join(str(w) for w in words[1:] if w) if kind == "STEP"
              else " ".join(str(w) for w in words), flush=True)


def progress(pct, key, detail=""):
    say("PROGRESS", "%d" % pct, key, detail)


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return ("%.0f %s" if unit in ("B", "KB") or n >= 100
                    else "%.1f %s") % (n, unit)
        n /= 1000.0


def write_atomic(path, data, mode=0o644):
    """write + fsync + rename + fsync(dir): a power cut leaves the old
    file or the new one, never half of either."""
    d = os.path.dirname(path) or "."
    os.makedirs(d, exist_ok=True)
    tmp = "%s.tmp.%d" % (path, os.getpid())
    with open(tmp, "wb") as f:
        f.write(data.encode() if isinstance(data, str) else data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.rename(tmp, path)
    fd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


# ── what is plugged in ────────────────────────────────────────────────

SKIP_PREFIX = ("loop", "ram", "zram", "sr", "fd", "dm-", "md", "nbd")


def part_path(disk, n):
    """The kernel's name for partition n: a "p" after a trailing digit."""
    return "/dev/%s%s%d" % (disk, "p" if disk[-1].isdigit() else "", n)


def mounted_devs():
    """major:minor of everything mounted or swapped on, and where."""
    out = {}
    for line in read("/proc/self/mountinfo").splitlines():
        f = line.split()
        if len(f) > 4:
            out.setdefault(f[2], f[4])
    for line in read("/proc/swaps").splitlines()[1:]:
        dev = line.split()[0] if line.split() else ""
        try:
            st = os.stat(dev)
            out.setdefault("%d:%d" % (os.major(st.st_rdev),
                                      os.minor(st.st_rdev)), "[swap]")
        except OSError:
            pass
    return out


def root_dev():
    """major:minor of the filesystem at /."""
    st = os.stat("/")
    return "%d:%d" % (os.major(st.st_dev), os.minor(st.st_dev))


def partitions_of(disk):
    base = "/sys/block/" + disk
    parts = []
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return parts
    for n in names:
        if n.startswith(disk) and os.path.exists(os.path.join(base, n, "partition")):
            parts.append({
                "name": n,
                "number": int(read(os.path.join(base, n, "partition"), "0")),
                "dev": read(os.path.join(base, n, "dev")),
                "start": int(read(os.path.join(base, n, "start"), "0")),
                "size": int(read(os.path.join(base, n, "size"), "0")) * 512,
            })
    return sorted(parts, key=lambda p: p["number"])


def udev_props(dev_majmin):
    """What udev recorded about a block device: PARTNAME, the GPT type,
    the filesystem. Empty when udev is not running."""
    props = {}
    for line in read("/run/udev/data/b" + dev_majmin).splitlines():
        if line.startswith("E:") and "=" in line:
            k, v = line[2:].split("=", 1)
            props[k] = v
    return props


def gpt_entries(disk):
    """GPT partition entries read straight off the disk: number -> (type,
    guid, name, first lba, last lba). Used where udev may know nothing."""
    out = {}
    dev = "/dev/" + disk
    try:
        bs = int(read("/sys/block/%s/queue/logical_block_size" % disk, "512"))
        with open(dev, "rb") as f:
            f.seek(bs)
            hdr = f.read(92)
            if hdr[:8] != b"EFI PART":
                return out
            elba, count, esize = struct.unpack_from("<QII", hdr, 72)
            f.seek(elba * bs)
            table = f.read(min(count, 256) * esize)
    except OSError:
        return out
    for i in range(len(table) // esize):
        e = table[i * esize:(i + 1) * esize]
        t = uuid.UUID(bytes_le=e[0:16])
        if t.int == 0:
            continue
        g = uuid.UUID(bytes_le=e[16:32])
        first, last = struct.unpack_from("<QQ", e, 32)
        name = e[56:128].decode("utf-16-le", "replace").split("\0")[0]
        out[i + 1] = (str(t).upper(), str(g), name, first, last)
    return out


def disk_of_majmin(majmin):
    """The whole disk a partition (or disk) with this dev number is on."""
    try:
        path = os.path.realpath("/sys/dev/block/" + majmin)
    except OSError:
        return None
    if os.path.exists(os.path.join(path, "partition")):
        path = os.path.dirname(path)
    return os.path.basename(path)


def list_disks():
    mounts = mounted_devs()
    running = disk_of_majmin(root_dev())
    disks = []
    for d in sorted(os.listdir("/sys/block")):
        if d.startswith(SKIP_PREFIX) or re.search(r"boot\d|rpmb$", d):
            continue
        base = "/sys/block/" + d
        size = int(read(base + "/size", "0")) * 512
        if size == 0:
            continue                        # an empty card reader
        # "ATA", "0x1af4" (virtio's PCI vendor id) and the like say nothing
        # a person would recognise; the model string is what is printed
        # on the drive's label.
        words = [read(base + "/device/" + k) for k in ("vendor", "model")]
        model = " ".join(w for w in words
                         if w and not w.startswith("0x") and w != "ATA").strip()
        if not model and d.startswith("vd"):
            model = "Virtual disk"
        path = os.path.realpath(base)
        tran = ("nvme" if d.startswith("nvme") else
                "usb" if "/usb" in path else
                "mmc" if d.startswith("mmcblk") else
                "virtio" if d.startswith("vd") else
                "sata" if "/ata" in path else "")
        parts = partitions_of(d)
        busy = [mounts[p["dev"]] for p in parts if p["dev"] in mounts]
        if read(base + "/dev") in mounts:
            busy.append(mounts[read(base + "/dev")])
        held = bool(os.listdir(base + "/holders")) if os.path.isdir(base + "/holders") else False
        for p in parts:
            hp = "%s/%s/holders" % (base, p["name"])
            if os.path.isdir(hp) and os.listdir(hp):
                held = True
        reason = ""
        if d == running:
            reason = "running"
        elif busy:
            reason = "mounted"
        elif held:
            reason = "in-use"
        elif read(base + "/ro") == "1":
            reason = "read-only"
        disks.append({
            "name": d,
            "path": "/dev/" + d,
            "model": model or d,
            "size": size,
            "size_text": human(size),
            "removable": read(base + "/removable") == "1",
            "transport": tran,
            "partitions": len(parts),
            "mounted": busy,
            "running": d == running,
            "usable": reason == "",
            "reason": reason,
        })
    return disks


def needed_bytes():
    """Space the new disk must have: the layout plus what / holds now."""
    st = os.statvfs("/")
    used = (st.f_blocks - st.f_bfree) * st.f_frsize
    return (ESP_MIB + RECOVERY_MIB) * 1024 ** 2 + used + ROOT_SLACK


# ── firmware facts ────────────────────────────────────────────────────

def efi_booted():
    return os.path.isdir("/sys/firmware/efi")


def ensure_efivars():
    if not efi_booted():
        return False
    if not os.path.ismount(EFIVARS):
        os.makedirs(EFIVARS, exist_ok=True)
        subprocess.run([tool("mount"), "-t", "efivarfs", "efivarfs", EFIVARS],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return os.path.ismount(EFIVARS)


def secure_boot_on():
    ensure_efivars()
    try:
        with open("%s/SecureBoot-%s" % (EFIVARS, EFI_GLOBAL), "rb") as f:
            data = f.read()
        return len(data) >= 5 and data[-1] == 1
    except OSError:
        return False


def intel_raid_present():
    """An Intel SATA controller in RAID mode (PCI class 01 04): the XPS's
    "RAID On", which hides the NVMe from Linux behind Intel RST."""
    root = "/sys/bus/pci/devices"
    try:
        devs = os.listdir(root)
    except OSError:
        return False
    for d in devs:
        cls = read("%s/%s/class" % (root, d))
        ven = read("%s/%s/vendor" % (root, d))
        if cls.startswith("0x0104") and ven == "0x8086":
            return True
    return False


def checks():
    disks = list_disks()
    usable = [d for d in disks if d["usable"]]
    out = {
        "efi": efi_booted(),
        "secure_boot": secure_boot_on(),
        "intel_raid": intel_raid_present(),
        "running_disk": disk_of_majmin(root_dev()),
        "needed": needed_bytes(),
        "problems": [],
    }
    if out["secure_boot"]:
        out["problems"].append({
            "key": "secure-boot",
            "en": "Secure Boot is on. LP's kernel is not signed by Microsoft, so "
                  "the installed system would not start. Turn it off: restart, "
                  "press F2, Secure Boot -> Secure Boot Enable -> off.",
            "ko": "Secure Boot 가 켜져 있습니다. LP 커널은 Microsoft 서명이 없어서 "
                  "설치해도 시작되지 않습니다. 다시 시작해 F2 를 누르고 "
                  "Secure Boot -> Secure Boot Enable 을 끄세요.",
        })
    if not usable and out["intel_raid"]:
        out["problems"].append({
            "key": "raid",
            "en": "No disk to install on: the SATA controller is in RAID mode, "
                  "which hides the NVMe disk. BIOS: System Configuration -> SATA "
                  "Operation -> change it to AHCI.",
            "ko": "설치할 디스크가 보이지 않습니다. SATA 컨트롤러가 RAID 모드라서 "
                  "NVMe 디스크가 숨겨져 있습니다. BIOS: System Configuration -> "
                  "SATA Operation -> AHCI 로 바꾸세요.",
        })
    elif not usable:
        out["problems"].append({
            "key": "no-disk",
            "en": "No disk to install on was found besides the one LP is running from.",
            "ko": "지금 LP 가 돌고 있는 디스크 말고는 설치할 디스크가 없습니다.",
        })
    return out, disks


# ── the install ───────────────────────────────────────────────────────

def wait_for(paths, seconds=15):
    end = time.time() + seconds
    while time.time() < end:
        if all(os.path.exists(p) for p in paths):
            return True
        time.sleep(0.2)
    return all(os.path.exists(p) for p in paths)


def mount(dev, where, *opts):
    os.makedirs(where, exist_ok=True)
    argv = [tool("mount")]
    for o in opts:
        argv += ["-o", o]
    run(argv + [dev, where])


def umount_all(root):
    """Everything under root, deepest first; quiet about what is not there."""
    points = []
    for line in read("/proc/self/mountinfo").splitlines():
        f = line.split()
        if len(f) > 4 and (f[4] == root or f[4].startswith(root + "/")):
            points.append(f[4])
    for p in sorted(points, key=len, reverse=True):
        subprocess.run([tool("umount"), p], stderr=subprocess.DEVNULL)


def running_part(name_want=None, type_want=None):
    """A partition on the disk we booted from, by GPT name or type."""
    disk = disk_of_majmin(root_dev())
    for n, (t, g, name, first, last) in gpt_entries(disk).items():
        if (name_want and name == name_want) or (type_want and t == type_want):
            return part_path(disk, n)
    return None


def copy_root(target, lo, hi):
    """rsync the running root, reporting lo..hi percent as it goes."""
    argv = [tool("rsync"), "-aHAXx", "--numeric-ids", "--no-inc-recursive",
            "--info=progress2", "--no-human-readable"]
    for e in EXCLUDES:
        argv.append("--exclude=" + e)
    argv += ["/", target + "/"]
    p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    buf = b""
    last = -1
    while True:
        chunk = p.stdout.read(256)
        if not chunk:
            break
        buf += chunk
        *lines, buf = re.split(rb"[\r\n]", buf)
        for ln in lines:
            m = re.search(rb"\s(\d+)%\s", ln)
            if m:
                pct = lo + (hi - lo) * int(m.group(1)) // 100
                if pct != last:
                    progress(pct, "copy")
                    last = pct
    err = p.stderr.read().decode(errors="replace")
    rc = p.wait()
    # 24: "some files vanished before they could be transferred" - a log
    # rotated or a lock file went away while the copy ran. Not a failure.
    if rc not in (0, 24):
        raise RuntimeError("copying the system failed (rsync %d): %s"
                           % (rc, (err.strip().splitlines() or [""])[-1]))


def make_fresh(target, lang):
    """The copy becomes a machine nobody has used."""
    for p in ("etc/lp/installer-medium", "var/lib/dbus/machine-id",
              "etc/ssh/ssh_host_rsa_key", "etc/ssh/ssh_host_rsa_key.pub",
              "etc/ssh/ssh_host_ecdsa_key", "etc/ssh/ssh_host_ecdsa_key.pub",
              "etc/ssh/ssh_host_ed25519_key", "etc/ssh/ssh_host_ed25519_key.pub",
              "var/lib/systemd/random-seed"):
        try:
            os.unlink(os.path.join(target, p))
        except FileNotFoundError:
            pass
    data = os.path.join(target, "data")
    if os.path.isdir(data):
        for n in os.listdir(data):
            if n.startswith("dropbear_") and n.endswith("_host_key"):
                os.unlink(os.path.join(data, n))
    # Empty, not absent: /etc/rc writes one when it finds it empty, and
    # an empty file is what systemd-style tools read as "not yet made".
    write_atomic(os.path.join(target, "etc/machine-id"), "", 0o444)
    write_atomic(os.path.join(target, "etc/lp/firstboot"),
                 "# lp-firstboot runs while this file exists and removes it.\n"
                 "lang=%s\n" % (lang or "en_US.UTF-8"))


def write_fstab(target, root_uuid, esp_uuid):
    write_atomic(os.path.join(target, "etc/fstab"),
                 "# Written by lp-install. By PARTUUID, which is this disk's alone:\n"
                 "# a label is shared with every other LP disk, the USB stick\n"
                 "# this was installed from among them.\n"
                 "PARTUUID=%s  /      ext4  defaults,errors=remount-ro  0 1\n"
                 "PARTUUID=%s  /boot  vfat  ro,umask=0077              0 2\n"
                 % (root_uuid, esp_uuid))


def fill_esp(esp_dev, esp_mnt, root_uuid):
    """The new EFI partition: kernel, boot menu, fallback path, cmdline."""
    src = os.path.join(WORK, "esp-src")
    src_dev = running_part(type_want=TYPE_ESP)
    have_src = False
    if src_dev:
        try:
            mount(src_dev, src, "ro")
            have_src = True
        except RuntimeError:
            pass
    try:
        def s(p):
            return os.path.join(src, p) if have_src else ""

        for d in ("EFI/BOOT", "EFI/LP"):
            os.makedirs(os.path.join(esp_mnt, d), exist_ok=True)
        # The kernel. Newer sticks keep it at \EFI\LP\vmlinuz.efi; on an
        # older one the fallback path is the kernel itself.
        kernel = next((p for p in (s("EFI/LP/vmlinuz.efi"), s("EFI/BOOT/BOOTX64.EFI"),
                                   "/boot/EFI/LP/vmlinuz.efi")
                       if p and os.path.isfile(p)), None)
        if not kernel:
            raise RuntimeError("the kernel was not found on this disk's EFI partition")
        shutil.copyfile(kernel, os.path.join(esp_mnt, "EFI/LP/vmlinuz.efi"))
        menu = s("EFI/LP/lpboot.efi")
        if menu and os.path.isfile(menu):
            shutil.copyfile(menu, os.path.join(esp_mnt, "EFI/LP/lpboot.efi"))
            shutil.copyfile(menu, os.path.join(esp_mnt, "EFI/BOOT/BOOTX64.EFI"))
        else:
            shutil.copyfile(kernel, os.path.join(esp_mnt, "EFI/BOOT/BOOTX64.EFI"))
        for extra in ("EFI/LP/initrd.img", "startup.nsh", "README.txt"):
            if have_src and os.path.isfile(s(extra)):
                shutil.copyfile(s(extra), os.path.join(esp_mnt, extra))
        # What the boot menu passes to the kernel for a normal boot. The
        # kernel's built-in line comes first and this is appended, and
        # the last root= wins - so this one names this disk's root.
        cmd = "root=PARTUUID=%s\n" % root_uuid
        for p in ("EFI/LP/cmdline.txt", "cmdline.txt"):
            with open(os.path.join(esp_mnt, p), "w") as f:
                f.write(cmd)
        return os.path.isfile(os.path.join(esp_mnt, "EFI/LP/lpboot.efi"))
    finally:
        if have_src:
            subprocess.run([tool("umount"), src], stderr=subprocess.DEVNULL)


def fill_recovery(rec_dev, rec_mnt):
    """The recovery system, copied from the stick's own LP-RECOVERY."""
    src_dev = running_part(name_want="LP-RECOVERY")
    if not src_dev:
        with open(os.path.join(rec_mnt, "README.txt"), "w") as f:
            f.write("This LP build carried no recovery system, so this partition\n"
                    "is empty. Installing from a newer LP USB stick fills it.\n")
        return False
    src = os.path.join(WORK, "recovery-src")
    mount(src_dev, src, "ro")
    try:
        run([tool("rsync"), "-aHAX", "--numeric-ids", src + "/", rec_mnt + "/"])
    finally:
        subprocess.run([tool("umount"), src], stderr=subprocess.DEVNULL)
    return True


# ── the firmware boot entry ───────────────────────────────────────────

FS_IOC_GETFLAGS = 0x80086601
FS_IOC_SETFLAGS = 0x40086602
FS_IMMUTABLE_FL = 0x10
EFI_ATTRS = 0x7            # non-volatile, boot service, runtime access


def efivar_path(name):
    return "%s/%s-%s" % (EFIVARS, name, EFI_GLOBAL)


def efivar_read(name):
    try:
        with open(efivar_path(name), "rb") as f:
            return f.read()[4:]
    except OSError:
        return None


def efivar_write(name, payload):
    """efivarfs wants attributes + data in one write(), and makes every
    variable immutable on creation so a stray `rm -rf /` cannot brick a
    machine. The flag comes off only for the variable being replaced."""
    path = efivar_path(name)
    if os.path.exists(path):
        fd = os.open(path, os.O_RDONLY)
        try:
            flags = bytearray(4)
            fcntl.ioctl(fd, FS_IOC_GETFLAGS, flags)
            v = struct.unpack("<I", flags)[0] & ~FS_IMMUTABLE_FL
            fcntl.ioctl(fd, FS_IOC_SETFLAGS, struct.pack("<I", v))
        finally:
            os.close(fd)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    try:
        os.write(fd, struct.pack("<I", EFI_ATTRS) + payload)
    finally:
        os.close(fd)


def efivar_delete(name):
    path = efivar_path(name)
    try:
        fd = os.open(path, os.O_RDONLY)
        try:
            flags = bytearray(4)
            fcntl.ioctl(fd, FS_IOC_GETFLAGS, flags)
            v = struct.unpack("<I", flags)[0] & ~FS_IMMUTABLE_FL
            fcntl.ioctl(fd, FS_IOC_SETFLAGS, struct.pack("<I", v))
        finally:
            os.close(fd)
        os.unlink(path)
    except OSError:
        pass


def load_option(desc, part_no, first_lba, n_lba, part_guid, loader, args):
    """EFI_LOAD_OPTION: HD(n,GPT,guid,start,size)/File(loader)/End."""
    hd = struct.pack("<BBHIQQ16sBB", 4, 1, 42, part_no, first_lba, n_lba,
                     uuid.UUID(part_guid).bytes_le, 2, 2)
    fname = (loader + "\0").encode("utf-16-le")
    fp = struct.pack("<BBH", 4, 4, 4 + len(fname)) + fname
    end = struct.pack("<BBH", 0x7F, 0xFF, 4)
    path = hd + fp + end
    opt = struct.pack("<IH", 1, len(path)) + (desc + "\0").encode("utf-16-le") + path
    if args:
        opt += (args + "\0").encode("utf-16-le")
    return opt


def option_part_guid(data):
    """The partition GUID an existing Boot#### points at, or None."""
    try:
        plen = struct.unpack_from("<H", data, 4)[0]
        off = 6
        while data[off:off + 2] != b"\0\0":
            off += 2
        off += 2
        end = off + plen
        while off + 4 <= end:
            t, s, ln = struct.unpack_from("<BBH", data, off)
            if t == 4 and s == 1 and ln >= 42:
                return str(uuid.UUID(bytes_le=bytes(data[off + 24:off + 40])))
            if t == 0x7F or ln < 4:
                break
            off += ln
    except (struct.error, ValueError, IndexError):
        pass
    return None


def option_desc(data):
    try:
        off = 6
        while data[off:off + 2] != b"\0\0":
            off += 2
        return data[6:off].decode("utf-16-le")
    except (UnicodeDecodeError, IndexError):
        return ""


def boot_entry(disk, esp_no, esp_guid, root_uuid, have_menu):
    if not ensure_efivars():
        return None
    first, last = gpt_entries(disk)[esp_no][3:5]
    if have_menu:
        loader, args = "\\EFI\\LP\\lpboot.efi", ""
    else:
        loader, args = "\\EFI\\LP\\vmlinuz.efi", "root=PARTUUID=%s" % root_uuid

    # Entries called "LP" that point at a partition no disk has any more
    # are what earlier installs of this disk left: remove them, or the
    # boot menu grows a dead "LP" per reinstall. Anybody else's entries,
    # and LP entries for disks that are merely unplugged, stay.
    present = set()
    for d in os.listdir("/sys/block"):
        for (_t, g, _n, _f, _l) in gpt_entries(d).values():
            present.add(g.lower())
    order = efivar_read("BootOrder") or b""
    nums = list(struct.unpack("<%dH" % (len(order) // 2), order[:len(order) // 2 * 2]))
    used = set()
    for n in os.listdir(EFIVARS):
        m = re.match(r"^Boot([0-9A-F]{4})-" + EFI_GLOBAL + "$", n)
        if not m:
            continue
        num = int(m.group(1), 16)
        data = efivar_read("Boot%04X" % num) or b""
        g = option_part_guid(data)
        if option_desc(data) == "LP" and g and g.lower() not in present:
            efivar_delete("Boot%04X" % num)
            nums = [x for x in nums if x != num]
            continue
        used.add(num)
    num = next(i for i in range(0x10000) if i not in used)
    efivar_write("Boot%04X" % num,
                 load_option("LP", esp_no, first, last - first + 1, esp_guid,
                             loader, args))
    nums = [num] + [x for x in nums if x != num]
    efivar_write("BootOrder", struct.pack("<%dH" % len(nums), *nums))
    return "Boot%04X" % num


# ── the install, in order ─────────────────────────────────────────────

def install(disk_path, yes, lang, boot_entry_wanted):
    info, disks = checks()
    name = os.path.basename(os.path.realpath(disk_path))
    disk = next((d for d in disks if d["name"] == name), None)
    if disk is None:
        raise Refused("no-such-disk", "%s is not a disk this machine has" % disk_path)
    if not disk["usable"]:
        raise Refused(disk["reason"], {
            "running": "%s is the disk LP is running from" % disk["path"],
            "mounted": "%s has mounted partitions (%s)" % (disk["path"], ", ".join(disk["mounted"])),
            "in-use": "%s is in use by device-mapper (LUKS or LVM)" % disk["path"],
            "read-only": "%s is read-only" % disk["path"],
        }.get(disk["reason"], disk["reason"]))
    for p in info["problems"]:
        if p["key"] == "secure-boot":
            raise Refused("secure-boot", p["en"])
    if disk["size"] < info["needed"]:
        raise Refused("too-small", "%s holds %s; LP needs at least %s"
                      % (disk["path"], disk["size_text"], human(info["needed"])))

    if not yes:
        print("Everything on %s (%s, %s) will be erased."
              % (disk["path"], disk["model"], disk["size_text"]))
        answer = input("Type the disk's name (%s) to go ahead: " % name).strip()
        if answer != name:
            raise Refused("cancelled", "nothing was written")

    t0 = time.time()
    os.makedirs(WORK, exist_ok=True)
    umount_all(WORK)
    dev = "/dev/" + name
    bs = int(read("/sys/block/%s/queue/logical_block_size" % name, "512"))
    mib = 1024 * 1024 // bs

    # 1. The partition table. sfdisk gives every partition and the disk a
    # fresh random GUID; --wipe clears the old signatures it finds, so a
    # filesystem that used to start at the same offset cannot be
    # mistaken for the new one.
    say("STEP", "partition", "Partitioning %s" % dev)
    progress(1, "partition")
    run([tool("wipefs"), "-a", "-q", dev])
    script = ("label: gpt\n"
              "first-lba: %d\n"
              "start=%d, size=%d, type=%s, name=\"LP-ESP\"\n"
              "size=%d, type=%s, name=\"LP-RECOVERY\"\n"
              "type=%s, name=\"LP-ROOT\"\n"
              % (mib, mib, ESP_MIB * mib, TYPE_ESP, RECOVERY_MIB * mib,
                 TYPE_LINUX, TYPE_ROOT_X86_64))
    run([tool("sfdisk"), "-q", "--wipe", "always", "--wipe-partitions", "always",
         dev], input=script)
    subprocess.run([tool("blockdev"), "--rereadpt", dev],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    p_esp, p_rec, p_root = (part_path(name, n) for n in (1, 2, 3))
    if not wait_for([p_esp, p_rec, p_root]):
        subprocess.run([tool("partx"), "-u", dev], stderr=subprocess.DEVNULL)
        if not wait_for([p_esp, p_rec, p_root], 10):
            raise RuntimeError("the new partitions did not appear")
    gpt = gpt_entries(name)
    esp_guid, rec_guid, root_guid = gpt[1][1], gpt[2][1], gpt[3][1]
    progress(3, "partition")

    # 2. Filesystems. ext4 with its journal (the defaults), which is what
    # makes a power cut cost the last few seconds rather than the disk.
    say("STEP", "format", "Formatting")
    for p in (p_esp, p_rec, p_root):
        subprocess.run([tool("wipefs"), "-a", "-q", p], stderr=subprocess.DEVNULL)
    run([tool("mkfs.vfat"), "-F", "32", "-n", ESP_FS_LABEL, p_esp])
    run([tool("mkfs.ext4"), "-F", "-q", "-L", "LP-RECOVERY", p_rec])
    progress(4, "format")
    run([tool("mkfs.ext4"), "-F", "-q", "-L", "LP-ROOT", p_root])
    progress(6, "format")

    target = os.path.join(WORK, "root")
    esp_mnt = os.path.join(WORK, "esp")
    rec_mnt = os.path.join(WORK, "recovery")
    try:
        mount(p_root, target)

        # 3. The system.
        say("STEP", "copy", "Copying LP")
        copy_root(target, 6, 88)
        for d, mode in (("proc", 0o555), ("sys", 0o555), ("dev", 0o755),
                        ("run", 0o755), ("tmp", 0o1777), ("boot", 0o755),
                        ("mnt", 0o755), ("media", 0o755)):
            p = os.path.join(target, d)
            os.makedirs(p, exist_ok=True)
            os.chmod(p, mode)
        make_fresh(target, lang)
        write_fstab(target, root_guid, esp_guid)
        progress(89, "copy")

        # 4. The recovery system.
        say("STEP", "recovery", "Setting up recovery")
        mount(p_rec, rec_mnt)
        has_recovery = fill_recovery(p_rec, rec_mnt)
        progress(94, "recovery")

        # 5. Boot.
        say("STEP", "boot", "Making the disk bootable")
        mount(p_esp, esp_mnt)
        have_menu = fill_esp(p_esp, esp_mnt, root_guid)
        entry = None
        if boot_entry_wanted:
            try:
                entry = boot_entry(name, 1, esp_guid, root_guid, have_menu)
            except OSError as e:
                # The fallback path boots the disk anyway; a firmware that
                # refuses new variables is worth a note, not a failed install.
                say("NOTE", "the firmware did not take a boot entry (%s);"
                    " the disk boots through \\EFI\\BOOT\\BOOTX64.EFI" % e)
        progress(98, "boot")

        say("STEP", "finish", "Finishing")
        run([tool("sync")])
    finally:
        umount_all(WORK)
    run([tool("sync")])
    progress(100, "done")
    say("DONE", "root=PARTUUID=%s" % root_guid,
        "esp=PARTUUID=%s" % esp_guid, "recovery=%s" % ("yes" if has_recovery else "empty"),
        "entry=%s" % (entry or "none"), "seconds=%d" % (time.time() - t0))


# ── the command line ──────────────────────────────────────────────────

def main():
    global PROGRESS
    ap = argparse.ArgumentParser(prog="lp-install",
                                 description="Install the running LP system onto a disk.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("list", help="the disks, and which could take LP")
    a.add_argument("--json", action="store_true")
    a = sub.add_parser("check", help="firmware settings that stop an install")
    a.add_argument("--json", action="store_true")
    a = sub.add_parser("install", help="erase a disk and install LP on it")
    a.add_argument("--disk", required=True)
    a.add_argument("--yes", action="store_true", help="do not ask; for scripts")
    a.add_argument("--progress", action="store_true",
                   help="machine-readable progress lines (for lp-installer)")
    a.add_argument("--lang", default="en_US.UTF-8",
                   help="language the first-boot setup starts in")
    a.add_argument("--no-boot-entry", action="store_true",
                   help="leave the firmware's boot list alone")
    args = ap.parse_args()

    if args.cmd == "list":
        disks = list_disks()
        if args.json:
            print(json.dumps(disks, ensure_ascii=False))
        else:
            for d in disks:
                print("%-10s %-9s %-6s %-32s %s" % (
                    d["path"], d["size_text"], d["transport"] or "-", d["model"][:32],
                    "ok" if d["usable"] else "no: " + d["reason"]))
        return 0
    if args.cmd == "check":
        info, _ = checks()
        if args.json:
            print(json.dumps(info, ensure_ascii=False))
        else:
            print("UEFI: %s  Secure Boot: %s  Intel RAID: %s  needs: %s" % (
                "yes" if info["efi"] else "no", "on" if info["secure_boot"] else "off",
                "yes" if info["intel_raid"] else "no", human(info["needed"])))
            for p in info["problems"]:
                print("problem:", p["en"])
        return 1 if info["problems"] else 0

    if os.geteuid() != 0:
        print("lp-install: installing needs root (sudo lp-install ...)", file=sys.stderr)
        return 1
    PROGRESS = args.progress
    try:
        install(args.disk, args.yes, args.lang, not args.no_boot_entry)
    except Refused as e:
        say("ERROR", e.key, str(e)) if PROGRESS else print("lp-install: %s" % e, file=sys.stderr)
        return 2
    except (RuntimeError, OSError) as e:
        say("ERROR", "failed", str(e)) if PROGRESS else print("lp-install: %s" % e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
