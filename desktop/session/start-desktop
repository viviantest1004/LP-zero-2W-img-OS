#!/bin/sh
# Bring the desktop up. /etc/rc runs this once the system is otherwise up.
#
# ── Why this does not run as root ──
#
# sway refuses to start as root, and it is right to: a compositor holds
# every keystroke on the machine. So there is an ordinary account, uid
# 1000, and dropprivs hands the session to it.
#
# What logind would normally do and nothing here does: hand that account
# the graphics card and the input devices. There is no logind, so the
# permissions are set here, once, on the devices that exist.
mkdir -p /data/log
mkdir -p /run/lp-session

# ── The memory, for Task Manager ──
#
# What kind it is (DDR4), how fast and in how many of the slots is in the
# firmware's DMI tables, which only root may read; so it is read here,
# once a boot, into a file anybody may. One line a slot, tab-separated:
# locator, size, type, rated speed, configured speed, form factor
# (desktop/tasks/tasks.c).
if ! test -s /run/lp-session/memory && command -v dmidecode > /dev/null 2>&1 ; then
    # (No awk functions: LP's own awk, first on the PATH, has none.)
    dmidecode -q -t 17 2> /dev/null | awk -F': *' '
        /^Memory Device/ {
            if (dev) printf "%s\t%s\t%s\t%s\t%s\t%s\n", loc, size, type, speed, conf, form
            dev = 1; loc = ""; size = ""; type = ""; speed = ""; conf = ""; form = ""
            next
        }
        /^\tLocator:/ { loc = $2 }
        /^\tSize:/ { size = $2 }
        /^\tType:/ { type = $2 }
        /^\tSpeed:/ { speed = $2 }
        /^\tConfigured (Memory|Clock) Speed:/ { conf = $2 }
        /^\tForm Factor:/ { form = $2 }
        END { if (dev) printf "%s\t%s\t%s\t%s\t%s\t%s\n", loc, size, type, speed, conf, form }' \
        > /run/lp-session/memory.new &&
        chmod 644 /run/lp-session/memory.new &&
        mv -f /run/lp-session/memory.new /run/lp-session/memory
fi

# ── Whose session ──
#
# uid 1000 at the start of the machine - or the account Settings > Users
# named for automatic sign-in - and after that whoever signed in last.
# The sign-in and lock screen can sign in another account: it asks
# lp-privd, which checks that account's password (the screen runs as the
# account at the screen and cannot), and lp-privd leaves the uid in
# /run/lp-session/next-user for the loop at the bottom. Logging out
# brings the same account back at the sign-in screen, where the others
# are a tap away. Everything below that hands the machine to "the
# desktop account" hands it to SEAT_UID.
person_uid() {
    awk -F: -v u="$1" 'BEGIN { if (u !~ /^[0-9]+$/ || u + 0 < 1000 || u + 0 >= 60000) exit }
                       $3 == u { f = 1 } END { exit !f }' /etc/passwd
}
SEAT_UID=1000
lp_auto=$(sed -n 1p /etc/lp/autologin 2>/dev/null)
if test -n "$lp_auto" ; then
    lp_auto_uid=$(awk -F: -v n="$lp_auto" '$1 == n { print $3; exit }' /etc/passwd)
    person_uid "$lp_auto_uid" && SEAT_UID=$lp_auto_uid
fi
# The devices go to the account at the screen (SEAT_UID; uid 1000 unless
# another signed in) - owner, read and write - and to their own
# groups, never to everybody. They were once opened 0666: any account,
# any daemon on the machine could then read every key typed, passwords
# included. udev does the same for anything plugged in later
# (/etc/udev/rules.d/71-lp-seat.rules); this covers what was there
# before udev's rules existed, and an image made before them.
seat_dev() {
    for d in "$@"; do
        test -c "$d" || continue
        chown "$SEAT_UID" "$d" > /dev/null 2>&1
        chmod 0660 "$d" 2>/dev/null
    done
}
# The virtual terminals are also given to the account, not only opened to
# everyone: libseat's built-in backend opens /dev/tty1 for its VT, and a
# mode alone does not hold. init puts a root shell on tty1 at about the
# moment the session starts, that shell reads Debian's /root/.profile,
# and its `mesg n` takes the write bits from group and others - tty1
# went 0666 -> 0644 a second after the chmod below, sway (uid 1000) then
# failed "Could not open target tty: Permission denied" three times, and
# an installed machine came up at a root prompt instead of the desktop.
# `mesg` never touches the owner's bits, so owning the node survives it.

# The keyboard of the VT under the session is switched off here, and
# the VT put in graphics mode - the two things libseat's built-in
# backend tries to do itself and cannot: the kernel lets only root, or a
# process whose controlling terminal the VT is, change them, and the
# session is neither ("Could not set KD keyboard mode to disabled:
# Operation not permitted" in session.log). Left alone, the VT's
# keyboard stays in unicode mode, and every key typed anywhere on the
# desktop is also typed into the VT - where init runs /bin/login on an
# installed machine (/etc/lp/console-login), the VT the session draws
# on. The password typed at the lock screen became a login name on
# tty1, in clear text on its screen, and each line after it one more
# login attempt. (K_OFF also keeps the kernel from switching VTs on
# Ctrl+Alt+Fn by itself, behind the compositor's back.) When the
# session gives up (below), the VT gets its keyboard back, so that
# login can be used after all.
vt_keyboard() {
    test -x /usr/bin/python3 || return 0
    /usr/bin/python3 - "$1" <<'PY' 2>/dev/null
import fcntl, os, sys
KDSETMODE, KDSKBMODE = 0x4B3A, 0x4B45
K_UNICODE, K_OFF, KD_TEXT, KD_GRAPHICS = 3, 4, 0, 1
vt = open("/sys/class/tty/tty0/active").read().strip()
fd = os.open("/dev/" + vt, os.O_RDWR | os.O_NOCTTY)
if sys.argv[1] == "off":
    fcntl.ioctl(fd, KDSKBMODE, K_OFF)
    fcntl.ioctl(fd, KDSETMODE, KD_GRAPHICS)
else:
    fcntl.ioctl(fd, KDSETMODE, KD_TEXT)
    fcntl.ioctl(fd, KDSKBMODE, K_UNICODE)
PY
}
vt_keyboard off

# 소리.
#
# udev 가 /dev/snd/* 를 audio 그룹 소유로 만들고, uid 1000 은 그
# 그룹에 없다. 그래서 pipewire 는 뜨지만 카드를 열지 못하고, 결국
# sink 가 하나도 없는 채로 남는다 - 퀵메뉴에는 "소리 장치가 없습니다"
# 라고 나오고, 소리 장치는 멀쩡히 있다.
#
# 그룹에만 기대지 않고 노드의 주인을 uid 1000 으로 하는 이유는,
# 여기에 logind 가 없어서 그룹 소속이 세션마다 갱신되지 않기
# 때문이다. 모두에게 여는 것(0666)은 하지 않는다 - 다른 계정이 마이크를
# 열 수 있게 된다.

# All of the above, for SEAT_UID; again for each session, since the
# account at the screen can change between two. The event nodes are
# every one there is, not the first six: the XPS has more input devices
# than that (keyboard, touchpad, touchscreen, pen, lid, buttons, the
# video bus), and the touchscreen was often past event5 - lp-osk could
# then not see that the last touch came from a finger, and never showed.
# A device plugged in later is given to the same account by udev
# (71-lp-seat.rules, lp-seat-own), which reads /run/lp-session/seat-uid.
seat_take() {
    mkdir -p "/run/user/$SEAT_UID"
    chown "$SEAT_UID:$SEAT_GID" "/run/user/$SEAT_UID" > /dev/null
    chmod 700 "/run/user/$SEAT_UID"
    echo "$SEAT_UID" > /run/lp-session/seat-uid
    seat_dev /dev/dri/card* /dev/dri/renderD* /dev/input/event* /dev/snd/* \
        /dev/hidraw* /dev/uinput
    chown "$SEAT_UID" /dev/tty0 /dev/tty1 /dev/tty2 > /dev/null 2>&1
    chmod 0620 /dev/tty0 /dev/tty1 /dev/tty2 2>/dev/null
}

# Which compositor: wayfire where there is 3D graphics, sway where
# there is not.
#
# wayfire draws the window frames - title, minimise, maximise, close -
# and the animations, and it draws everything with OpenGL. Without a
# GPU that is Mesa's software path (kms_swrast), and on a virtual
# graphics card with no 3D (QEMU's virtio-vga, UTM's default) wlroots'
# GL renderer dies on the first frame there: tested, wayfire and sway
# both. sway can instead draw on the CPU (pixman), so it is the one
# that runs there; its windows draw their own frames (foot and GTK
# apps do, see foot.ini and sway.config).
#
# The decision needs dmesg, which only root may read, so it is made
# here and handed to the session in a file (setpriv --reset-env clears
# the environment). session-run still falls back to sway if wayfire
# dies at the start anyway, so a wrong guess costs seconds, not the
# desktop. /etc/lp/compositor (wayfire, sway or auto) overrides it.
mkdir -p /run/lp-session
comp=sway
why="no 3D graphics found"
for card in /sys/class/drm/card[0-9]*; do
    test -e "$card/device/driver" || continue
    drv=$(basename "$(readlink -f "$card/device/driver")")
    case $drv in
        # xe: Intel's driver for Lunar Lake and the Arc B-series, which
        # i915 does not drive. Its OpenGL is Mesa 25's, from backports
        # (tools/apply-packages.sh); bookworm's Mesa 22.3 had none.
        i915|xe|amdgpu|radeon|nouveau|vmwgfx)
            comp=wayfire; why="$drv"; break ;;
        virtio_gpu|virtio-pci|virtio_pci)
            # virtio-gpu has 3D only when the host gave it virgl (UTM: a
            # "GPU Supported" display; QEMU/KVM: virtio-vga-gl, virt-manager's
            # "3D acceleration"). Then wayfire, with its animations, as on
            # real hardware - under KVM too: for a while KVM got sway here,
            # because the pointer trailed the hand and the screen flickered
            # where it moved; the pointer is now on the GPU's cursor plane
            # and drawn by the host (session-run), which is what that was.
            if dmesg 2>/dev/null | grep -q 'features: +virgl'; then
                comp=wayfire; why="virtio-gpu with virgl"; break
            fi
            why="virtio-gpu without 3D (virgl)" ;;
        *)  why="$drv: no 3D" ;;
    esac
done
if test -s /etc/lp/compositor; then
    read -r want < /etc/lp/compositor
    case $want in
        # The card stays in the reason: session-run reads "virtio" there.
        wayfire|sway) comp=$want; why="/etc/lp/compositor ($why)" ;;
    esac
fi

# Safe mode: sway drawing on the CPU (pixman), whatever the card and
# whatever anybody chose - the way out of a desktop that hangs or dies in
# the graphics driver, as Windows' safe mode is. Asked for with `sudo
# lp-safe-mode` (the next boot only) or lp.safe=1 on the kernel's command
# line; also taken by itself below when the desktop has died three times
# in a row at the start.
rm -f /run/lp-session/safe
if grep -qw 'lp.safe=1' /proc/cmdline 2>/dev/null || test -e /etc/lp/safe-mode-next; then
    rm -f /etc/lp/safe-mode-next
    comp=sway; why="safe mode (asked for)"
    echo asked > /run/lp-session/safe
fi
write_compositor() {
    printf '%s\n%s\n' "$comp" "$why" > /run/lp-session/compositor
    chmod 644 /run/lp-session/compositor
}
write_compositor

# The account's home. uid 1000 is "user" in the image as built and the
# name the person chose once the installer has run (it keeps /home/user
# as a link to the real home, for scripts written against the old name).
#
# 홈이 root 소유로 남아 있으면 세션이 설정 하나 저장하지 못한다.
# 이미지를 만들 때 맞춰 두지만, 첫 부팅에서 expandfs 가 파티션을
# 늘리고 나면 새로 생기는 것들이 있어 여기서 한 번 더 맞춘다.
#
# An account made later (Settings > Users: useradd) starts with a home
# that has none of the desktop's own files - no wayfire.ini, so wayfire
# came up with none of LP's shortcuts, panels or plugins. The first time
# it signs in, it gets what the image's own account started with
# (/usr/share/lp/home, tools/mkdesktop.sh), copying nothing over a file
# that is already there.
seat_home() {
    SEAT_GID=$(awk -F: -v u="$SEAT_UID" '$3 == u { print $4; exit }' /etc/passwd)
    test -n "$SEAT_GID" || SEAT_GID=$SEAT_UID
    LP_HOME=$(awk -F: -v u="$SEAT_UID" '$3 == u { print $6; exit }' /etc/passwd)
    test -n "$LP_HOME" || LP_HOME=/home/user
    if ! test -e "$LP_HOME/.config/wayfire.ini" && test -d /usr/share/lp/home ; then
        mkdir -p "$LP_HOME"
        /usr/bin/cp -an /usr/share/lp/home/. "$LP_HOME/" 2>/dev/null
    fi
    # LP's chown names every file it changes (-q would not, but GNU's
    # chown has no -q): the whole home, a browser profile's thousands of
    # files, went line by line to the console at every sign-in.
    chown -R "$SEAT_UID:$SEAT_GID" "$LP_HOME/" > /dev/null 2>&1
}

# Every process the account still has when its session ends - pipewire
# holding the sound card, a download, a terminal's shell, and the shell's
# own loops (lp-shell-start) - ends before the next session starts, the
# same account's or another's. Logging out is every window closing, and
# what was left ran on into the next session: lp-shell-start's loops tell
# that the compositor is gone by its socket, and the next session's
# compositor makes one of the same name, so after each logout the last
# session's loops started their bar, dock, input methods (fcitx5 three
# times over after two logouts) into the new one beside its own. And the
# devices are about to become the next account's, whose pipewire could
# not open a card the last one still held. Sent as that account, so it
# can reach nothing else.
end_account() {
    test -x /usr/bin/setpriv || return 0
    gid=$(awk -F: -v u="$1" '$3 == u { print $4; exit }' /etc/passwd)
    /usr/bin/setpriv --reuid="$1" --regid="${gid:-$1}" --clear-groups \
        /bin/sh -c 'kill -TERM -1 2>/dev/null; sleep 2; kill -KILL -1 2>/dev/null' 2>/dev/null
}

# The session gets the account's groups - sudo, audio, video, ... - the
# way a login would. dropprivs clears them (right for a network daemon,
# wrong for a person): with only its own group the person was not in
# sudo, so sudo refused them with their own password, and every other
# group the installer gave them counted for nothing. setpriv
# --init-groups reads /etc/group exactly as login does.
#
# The session runs again when it ends: after a logout (lp-logout), which
# brings it back locked, and after a crash of the compositor, which
# should not leave the machine at a black screen. Three quick deaths in
# a row (under 30 s each) is a session that cannot start; it is left
# down then, and /data/log/session.log has what it printed.
run_session() {
    if test -x /usr/bin/setpriv; then
        /usr/bin/setpriv --reuid="$SEAT_UID" --regid="$SEAT_GID" --init-groups \
            --reset-env /bin/session-run
    else
        dropprivs "$SEAT_UID:$SEAT_GID" /bin/session-run
    fi
}
# The boot screen (/bin/splash: the PC maker's logo, ours under it and a
# spinner) holds until it is told the desktop is coming; told here, just
# before the compositor takes the screen. It returns once the splash has
# stopped drawing, leaving its last frame up for the compositor to replace.
test -x /bin/splash && /bin/splash stop

# ── the desktop came up, or it did not ──
#
# From here until the compositor draws, the screen is the splash's last
# frame - the logo, no spinner. A compositor that died left it there for
# a second; one that hung (a graphics driver that never answered) left it
# there for good, at every start: "the logo, and nothing after it". And
# /etc/rc had already told the boot menu that the start had worked, so
# the menu never offered Recovery either.
#
# So each session is watched until lp-shell-start, the first thing the
# compositor runs, says it is up ($XDG_RUNTIME_DIR/lp-desktop-up). Then
# the start is confirmed to the boot menu (once a boot). A session that
# does not get there in time is ended and started again in safe mode
# (sway drawing on the CPU), as after three quick deaths; if safe mode
# does not come up either, the console is given back.
#
# The time: a desktop is up in a few seconds on any real machine, so a
# minute is a hang. A virtual machine without KVM (UTM emulating a PC on
# a Mac) runs every instruction through QEMU and can take minutes, so a
# guest gets five.
up_limit=60
grep -qw hypervisor /proc/cpuinfo 2>/dev/null && up_limit=300
boot_confirmed=0
desktop_came_up() {
    lp_waited=0
    while kill -0 "$1" 2>/dev/null; do
        if test -e "/run/user/$SEAT_UID/lp-desktop-up"; then
            if test $boot_confirmed = 0; then
                lp-reboot-recovery --boot-ok > /dev/null 2>&1
                boot_confirmed=1
            fi
            return 0
        fi
        if test $lp_waited -ge $up_limit; then
            return 1
        fi
        sleep 1
        lp_waited=$((lp_waited + 1))
    done
    return 0        # it ended by itself: counted below like any end
}

quick=0
rm -f /run/lp-session/next-user /run/lp-session/signed-in
while :; do
    # Another account signed in at the sign-in screen (lp-privd checked
    # its password): its session next, and not locked again - the
    # password was typed a moment ago (lp-shell-start reads signed-in).
    if test -s /run/lp-session/next-user; then
        read -r lp_next < /run/lp-session/next-user
        rm -f /run/lp-session/next-user
        if person_uid "$lp_next" ; then
            if test "$lp_next" != "$SEAT_UID" ; then
                echo "start-desktop: uid $SEAT_UID signed out, uid $lp_next signs in" >> /data/log/session.log
                SEAT_UID=$lp_next
            fi
            echo "$SEAT_UID" > /run/lp-session/signed-in
            chmod 644 /run/lp-session/signed-in
        fi
    fi
    seat_home
    seat_take
    rm -f "/run/user/$SEAT_UID/lp-desktop-up"
    read -r t0 _ < /proc/uptime
    run_session >> /data/log/session.log 2>&1 &
    lp_session=$!
    hung=0
    if desktop_came_up $lp_session; then
        wait $lp_session
    else
        hung=1
        echo "start-desktop: the desktop did not come up within ${up_limit}s; ending it" >> /data/log/session.log
        end_account "$SEAT_UID"
        # A process stuck inside a driver ignores even SIGKILL; it is not
        # waited for past ten seconds.
        lp_waited=0
        while kill -0 $lp_session 2>/dev/null && test $lp_waited -lt 10; do
            sleep 1
            lp_waited=$((lp_waited + 1))
        done
        kill -0 $lp_session 2>/dev/null || wait $lp_session
    fi
    read -r t1 _ < /proc/uptime
    end_account "$SEAT_UID"
    rm -f /run/lp-session/signed-in
    if test $hung = 1; then
        if ! test -e /run/lp-session/safe; then
            echo "start-desktop: starting it in safe mode" >> /data/log/session.log
            comp=sway; why="safe mode (the desktop did not come up within ${up_limit}s)"
            echo auto > /run/lp-session/safe
            write_compositor
            quick=0
            continue
        fi
        echo "start-desktop: safe mode did not come up either; not starting it again" >> /data/log/session.log
        vt_keyboard on
        exit 1
    fi
    if test -e "/run/user/$SEAT_UID/lp-logout" || test -s /run/lp-session/next-user; then
        quick=0
        continue
    fi
    if test $(( ${t1%.*} - ${t0%.*} )) -lt 30; then
        quick=$((quick + 1))
    else
        quick=0
    fi
    if test $quick -ge 3; then
        # Three quick deaths: first try once more in safe mode (a driver
        # or a 3D path that kills the compositor is the usual cause), and
        # only give up when that dies too.
        if ! test -e /run/lp-session/safe; then
            echo "start-desktop: the session ended three times within 30 s; starting it in safe mode" >> /data/log/session.log
            comp=sway; why="safe mode (the desktop failed to start three times)"
            echo auto > /run/lp-session/safe
            write_compositor
            quick=0
            continue
        fi
        echo "start-desktop: the session ended three times within 30 s; not starting it again" >> /data/log/session.log
        vt_keyboard on
        exit 1
    fi
    sleep 1
done
