@@ -96,6 +99,43 @@
         }
     });
 
+    /* The keyboard grab (LP): while the input method holds it, keys that no
+     * binding took go to the input method and not to the application, as
+     * in sway (keyboard.cpp sends them). The input method gets the
+     * keyboard in use now and its modifiers at once, and the application
+     * gets the modifiers back when the grab ends. */
+    on_grab_keyboard.set_callback([&] (void *data)
+    {
+        auto grab = static_cast<wlr_input_method_keyboard_grab_v2*>(data);
+        auto kbd  = wlr_seat_get_keyboard(wf::get_core().get_current_seat());
+        for (auto& dev : wf::get_core().get_input_devices())
+        {
+            auto wlr_dev = dev->get_wlr_handle();
+            if (kbd && (wlr_dev->type == WLR_INPUT_DEVICE_KEYBOARD) &&
+                (wlr_dev->keyboard == kbd) && (grab_for(wlr_dev) == grab))
+            {
+                wlr_input_method_keyboard_grab_v2_set_keyboard(grab, kbd);
+                wlr_input_method_keyboard_grab_v2_send_modifiers(grab,
+                    &kbd->modifiers);
+                break;
+            }
+        }
+
+        on_grab_keyboard_destroy.disconnect();
+        on_grab_keyboard_destroy.connect(&grab->events.destroy);
+    });
+
+    on_grab_keyboard_destroy.set_callback([&] (void *data)
+    {
+        auto grab = static_cast<wlr_input_method_keyboard_grab_v2*>(data);
+        on_grab_keyboard_destroy.disconnect();
+        if (grab->keyboard)
+        {
+            wlr_seat_keyboard_notify_modifiers(wf::get_core().get_current_seat(),
+                &grab->keyboard->modifiers);
+        }
+    });
+
     on_text_input_new.connect(&wf::get_core().protocols.text_input->events.text_input);
     on_input_method_new.connect(
         &wf::get_core().protocols.input_method->events.input_method);
@@ -103,6 +143,25 @@
     wf::get_core().connect_signal("keyboard-focus-changed", &keyboard_focus_changed);
 }
 
+wlr_input_method_keyboard_grab_v2*wf::input_method_relay::grab_for(
+    wlr_input_device *keyboard)
+{
+    if (!input_method || !input_method->keyboard_grab)
+    {
+        return nullptr;
+    }
+
+    auto grab = input_method->keyboard_grab;
+    auto vkbd = wlr_input_device_get_virtual_keyboard(keyboard);
+    if (vkbd && (wl_resource_get_client(vkbd->resource) ==
+                 wl_resource_get_client(grab->resource)))
+    {
+        return nullptr;
+    }
+
+    return grab;
+}
