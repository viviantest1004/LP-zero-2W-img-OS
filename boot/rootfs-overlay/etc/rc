# /etc/rc - 부팅 스크립트. init 이 한 번만 실행한다.
#
# 계속 살아 있어야 하는 프로그램은 여기가 아니라 /etc/services 에 둔다.
# 여기서 띄우면 죽어도 아무도 되살리지 않는다.
#
# 우리 셸이 실행한다. 변수 확장이나 if 는 없지만 && || ; 가 되므로
# 실패해도 부팅이 멈추지 않도록 폴백을 붙여 쓴다.

echo "[rc] 커널 메모리 여유 설정"
# root 가 항상 쓸 수 있는 예비 메모리. 메모리가 말라도 관리자가
# 프로세스를 정리할 여지를 남긴다. 기본 8MB 는 너무 빡빡하다.
echo 65536 > /proc/sys/vm/admin_reserve_kbytes || echo "[rc]   설정 실패"
# 커널이 항상 확보해두는 최소 여유. 너무 낮으면 할당이 갑자기 실패한다.
echo 16384 > /proc/sys/vm/min_free_kbytes || echo "[rc]   설정 실패"

echo "[rc] 메모리 안전장치"
# RAM 안에 압축 스왑을 만든다. SD 에는 쓰지 않는다.
zram on 256 || echo "[rc]   zram 없이 계속합니다"
# 여유 감시 + 커널 OOM 우선순위 조정.
# 보호 대상(init/sh/dropbear/wpa_supplicant/memwatch)에는
# oom_score_adj=-1000 을 걸어 커널 OOM Killer 도 건드리지 못하게 한다.
memwatch -d -r 32 -w 64 || echo "[rc]   memwatch 시작 실패"

echo "[rc] 저장장치 준비"
# 이미지가 256MB 라 큰 카드에 구우면 나머지가 미할당으로 남는다.
# 첫 부팅에 파티션과 파일시스템을 카드 끝까지 늘린다.
# 실기는 /dev/mmcblk0(SD), QEMU 는 /dev/vda(virtio) 다. 둘 다 시도한다.
expandfs || expandfs /dev/vda /dev/vda2 || echo "[rc]   확장 없음"
mount /dev/mmcblk0p2 /data || mount /dev/vda2 /data || echo "[rc]   데이터 파티션 없음 - RAM 으로 계속합니다"

echo "[rc] 시계 복원"
# Pi Zero 2 W 에는 배터리로 도는 시계(RTC)가 없다. 전원을 넣으면 커널
# 시계가 1970년에서 시작한다. 그 상태로 두면 파일 시각이 엉망이 되고,
# HTTPS 는 서버 인증서가 "미래에 발급된 것"으로 보여 전부 실패한다.
# 우선 지난번에 저장해둔 시각으로 올려둔다. 정확하진 않아도 1970년보다
# 훨씬 낫다. 진짜 시각은 네트워크가 올라온 뒤에 맞춘다.
ntp -r || echo "[rc]   저장된 시각이 없습니다 (첫 부팅)"

echo "[rc] 홈 디렉터리를 저장장치로"
# /root 는 원래 RAM 이라 재부팅하면 사라진다. 데이터 파티션의
# 디렉터리를 그 자리에 겹쳐 붙여(bind) 홈에 저장한 것이 남게 한다.
mkdir -p /data/root/.ssh && mount -o bind /data/root /root || echo "[rc]   홈은 RAM 입니다 (재부팅 시 사라짐)"
# -n: 이미 있으면 덮지 않는다. 사용자가 넣어둔 키를 매 부팅마다
# 빈 기본값으로 지워버리면 안 된다.
cp -n /etc/authorized_keys /root/.ssh/authorized_keys

echo "[rc] 부트 파티션에서 설정 읽기"
# 부트 파티션은 FAT32 다. 윈도우·맥에서도 그냥 보인다.
# SD 를 PC 에 꽂아 여기에 파일을 넣어두면 다음 부팅에 적용된다.
# 리눅스 없이 기기를 설정할 수 있는 유일한 통로라 중요하다.
#
#   authorized_keys       SSH 공개키 (이게 있어야 원격 접속이 된다)
#   wpa_supplicant.conf   무선 공유기 정보
#
# -q: 파일이 없는 것은 정상이므로 오류를 찍지 않는다.
mkdir -p /boot && mount /dev/mmcblk0p1 /boot || mount /dev/vda1 /boot || echo "[rc]   부트 파티션을 읽지 못했습니다"
cp -q /boot/authorized_keys /root/.ssh/authorized_keys && echo "[rc]   SSH 공개키를 가져왔습니다"
cp -q /boot/wpa_supplicant.conf /data/wpa_supplicant.conf && echo "[rc]   무선 설정을 가져왔습니다"

echo "[rc] 무선 설정 준비"
# 데이터 파티션의 설정을 우선한다. SD 를 다시 굽지 않고 공유기 정보를
# 바꿀 수 있기 때문이다.
cat /data/wpa_supplicant.conf > /etc/wpa.conf || cat /etc/wpa_supplicant.conf > /etc/wpa.conf

echo "[rc] 무선 인터페이스 시작"
wpa_supplicant -B -i wlan0 -c /etc/wpa.conf || echo "[rc]   무선 없이 계속합니다"

echo "[rc] 주소 요청"
#   wlan0  무선
#   eth0   USB 이더넷 어댑터 (호스트 모드)
#   usb0   USB 가젯 - PC 에 연결했을 때
dhcp wlan0 || dhcp eth0 || dhcp usb0 || echo "[rc]   주소를 받지 못했습니다"

echo "[rc] 시각 동기화"
# 이게 되어야 HTTPS 가 된다. 실패해도 부팅은 계속하지만,
# 그때는 파이썬의 인증서 검증이 실패할 수 있다.
ntp || echo "[rc]   시각을 못 받았습니다 - HTTPS 인증서 검증이 실패할 수 있습니다"

# 사용자 시작 스크립트. 데이터 파티션에 있으면 실행한다.
# 이미지를 다시 굽지 않고 부팅할 때 할 일을 추가할 수 있는 자리다.
# (-q: 파일이 없으면 조용히 넘어간다)
sh -q /data/rc.local

echo "[rc] 완료 (SSH 는 init 이 /etc/services 로 띄웁니다)"
