#!/bin/sh
# lp-lock - lock the screen: the wallpaper, dimmed, and the password.
#
# The quick settings panel's lock button, Super+L and a logout all come
# here. swaylock checks the password through PAM (/etc/pam.d/swaylock),
# the account's own, the same one sudo asks for.
#
# The ring is the theme's: teal while typing, orange on each key, red
# when the password was wrong. It shows from the start
# (--indicator-idle-visible): the machine now locks at every boot, and a
# screen showing only the wallpaper did not say that it wanted a
# password.
#
# An account with no usable password is not locked at all. Try's live
# account is one ("!" in /etc/shadow, `passwd -S` says L): Log out there
# brought the session back behind a lock that answered "Wrong" to
# everything, and the only way on was the power button - the same for
# the lock button and Super+L. Only when the status cannot be read is
# the screen locked anyway.
lp_pw=$(/usr/bin/passwd -S "$(id -un)" 2> /dev/null | awk '{ print $2 }')
if test -n "$lp_pw" && test "$lp_pw" != P ; then
    echo "lp-lock: $(id -un) has no password to unlock with ($lp_pw); not locking" >&2
    exit 0
fi
WALL=/usr/share/backgrounds/lp/lp-wallpaper-dark-3840x2160.png
set -- -f --show-failed-attempts --indicator-idle-visible \
    --color 0B1722 \
    --inside-color 0B1722CC --inside-clear-color 0B1722CC \
    --inside-ver-color 16304ACC --inside-wrong-color 3A1414CC \
    --ring-color 1FB5A8 --ring-ver-color 1FB5A8 --ring-clear-color 9FB3C4 \
    --ring-wrong-color E8663D --key-hl-color F28C28 --bs-hl-color E8663D \
    --line-color 00000000 --line-clear-color 00000000 \
    --line-ver-color 00000000 --line-wrong-color 00000000 \
    --separator-color 00000000 \
    --text-color EAF2F8 --text-clear-color EAF2F8 \
    --text-ver-color EAF2F8 --text-wrong-color EAF2F8 \
    --indicator-radius 90 --indicator-thickness 8 \
    --font "Pretendard Variable"
test -r "$WALL" && set -- "$@" -i "$WALL" -s fill
exec swaylock "$@"
