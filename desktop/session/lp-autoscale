#!/usr/bin/python3
"""lp-autoscale - scale 2 on high-density outputs, 1 elsewhere.

The XPS 15's panel is 3840x2160 on 15.6 inches: at scale 1 every button
is a quarter of the size a finger needs. An external 1080p monitor wants
scale 1. sway's config cannot say "if the mode is wider than 2560", so
this runs from exec_always and on every output change, and asks sway.
A scale someone set by hand in Settings (~/.config/lp/scale-<output>)
wins over the guess.
"""
import json, os, subprocess, sys

def outputs():
    r = subprocess.run(["swaymsg", "-r", "-t", "get_outputs"],
                       capture_output=True, text=True)
    return json.loads(r.stdout or "[]")

conf = os.path.expanduser("~/.config/lp")
for o in outputs():
    name = o.get("name", "")
    mode = o.get("current_mode") or {}
    want = "2" if mode.get("width", 0) >= 2560 else "1"
    try:
        with open(os.path.join(conf, "scale-" + name)) as f:
            want = f.read().strip() or want
    except OSError:
        pass
    if str(o.get("scale")) not in (want, want + ".0"):
        subprocess.run(["swaymsg", "output", name, "scale", want],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
