# 빌드 산출물
build/
userland/bin/
*.o
*.d
*.elf
*.map
*.img
!.gitkeep

# 다운로드받은 클로즈드 블롭 (재현 가능하므로 커밋하지 않는다)
blobs/

# SD카드 이미지 조립 결과
sdcard/

# 에디터
.vscode/
.idea/
*.swp
qemu-out/
userland/rootfs/
userland/initramfs.cpio.gz
kernel/out/
dist/

# tools/build-sdk.sh 가 만든다 (userland/libc 에서 뽑아낸 것뿐)
sdk/

# tools/mkpkg.sh 가 만든 로컬 패키지 저장소
repo/

# tools/common.sh 가 정하는 빌드 작업 디렉터리 (커널 소스, sysroot 등)
.build/
