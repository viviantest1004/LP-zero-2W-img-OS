# ~/.config/sway/config
#
# 창 모양은 목업이 정하고, 단축키는 명세서 5-9 가 정한다. 여기 있는
# 것 중 이 파일이 스스로 정한 값은 하나도 없다.

# ── 창 ────────────────────────────────────────────────────────────
#
# The window mockup is floating windows that overlap, each drawing its own
# header bar. So: nothing tiles, and sway draws no decoration of its own -
# a second title bar above an application's header bar would be the
# ugliest thing on the screen.
for_window [app_id=".*"] floating enable
for_window [class=".*"]  floating enable
gaps inner 0

# Window frames. sway is the session on a machine without 3D graphics
# (session-run); there it cannot draw minimise/maximise/close buttons,
# so the windows draw their own: GTK apps their header bars (with the
# buttons GSettings' button-layout names), foot its own title bar
# ([csd] in foot.ini). sway honours a floating window's request to
# decorate itself, and gives those windows no frame of its own.
#
# A window that asks for nothing (an X11 program, a GTK 3 window with no
# header bar) gets sway's title bar instead: at least a title, a place to
# drag it by, and a thin edge - not a bare rectangle nothing can move.
default_border normal 1
default_floating_border normal 1
titlebar_border_thickness 0
titlebar_padding 10 6
font pango:Pretendard Variable 10
# The frame colours of the theme (deep blue, the orange accent on the
# focused window's edge): border, background, text, indicator, child.
client.focused          #1C3B57 #1C3B57 #EAF2F8 #F28C28 #1C3B57
client.focused_inactive #13263A #13263A #9FB3C4 #13263A #13263A
client.unfocused        #13263A #13263A #9FB3C4 #13263A #13263A
client.urgent           #F28C28 #F28C28 #0B1722 #F28C28 #F28C28

# The desktop, from the design system.
# The wallpaper at the panel's own resolution, so nothing resamples it;
# the plain colour stays underneath for the instant before it loads.
output * bg #0B1722 solid_color
output * bg /usr/share/backgrounds/lp/lp-wallpaper-dark-3840x2160.png fill #0B1722

# The top bar and the dock reserve their own space (layer-shell
# exclusive zones); windows are placed in what is left.

# 퀵메뉴. 레이어 셸이 아니라 보통 창이라서, 다른 창처럼 다뤄지지
# 않도록 여기서 따로 말해 준다: 테두리 없음, 모든 작업공간에 따라옴,
# 크기는 자기가 정한 320px 그대로.
for_window [app_id="org.lpzero.QuickMenu"] floating enable, border none, sticky enable

set $mod Mod4

# ── 5-9 단축키 ────────────────────────────────────────────────────

# Every shortcut both compositors share - the apps, the window keys
# (Super+Up maximizes, Super+Down minimizes, Alt+F4 closes), 한/영 on
# Super+Space, screenshots, volume and brightness - is in this file,
# which Settings > Keyboard writes from wayfire.ini, the one list of
# them; a shortcut changed there works here too. mkdesktop puts the
# default one in place (desktop/session/sway-keys.conf).
include ~/.config/sway/lp-keys.conf

# 작업공간. 명세서 5-8 의 상한이 20 이므로 열 개까지만 키에 걸고
# 나머지는 레일을 눌러서 간다.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

bindsym $mod+Shift+e exit
floating_modifier $mod normal

input * {
    xkb_layout us
    xkb_options grp:alt_shift_toggle
}

# 설정 앱이 키보드 배열을 바꾸면 이 파일에 적는다. 위의 기본값 뒤에
# 오므로, 있으면 이쪽이 이긴다. mkdesktop 이 빈 파일을 미리 만들어
# 둔다 - sway 는 없는 파일을 include 하면 오류를 찍는다.
include ~/.config/sway/input.conf

# ── 로그인할 때 시작하는 것 ───────────────────────────────────────

# Everything on the screen that is not a window - wallpaper and desktop
# icons, the top bar, the dock, the on-screen keyboard, notifications,
# sound, the portals, the screen-off timer - is started by lp-shell-start,
# the same program wayfire starts, and brought back if a piece of it dies.
exec /usr/local/bin/lp-shell-start

# Scale 2 on the 4K panel, 1 on ordinary monitors (see lp-autoscale),
# again whenever an output comes or goes.
exec_always /usr/local/bin/lp-autoscale
