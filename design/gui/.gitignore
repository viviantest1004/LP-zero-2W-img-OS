# Built by bundle.py: the same pages with everything folded in, for
# sending. Regenerated in a second, half a megabyte of base64 in a diff
# nobody can read - so it is made on demand rather than kept.
dist/

# What check.js photographs on its way through. Useful to look at after
# a run, worthless in a diff.
shot-*.png

# assemble.py rebuilds this from panes/ and the lp-* files in about a
# second, so it is output rather than source. Keeping it tracked meant
# every run of the assembler - including the ones the design agents do
# to check their own work - showed up as a change to review.
settings.html
