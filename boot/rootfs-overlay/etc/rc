# /etc/rc - the boot script. init runs it exactly once.
#
# Anything that has to stay alive belongs in /etc/services, not here.
# Nothing started from this file gets restarted when it dies.
#
# Our own shell runs this. There is no variable expansion and no if, but
# && || ; all work, so every step carries a fallback and a failure never
# stops the boot.

echo "[rc] naming the machine"
# Without this the hostname is "(none)", which shows up in the shell
# prompt and in every log line. One word, and the machine has a name.
echo lpzero > /proc/sys/kernel/hostname || echo "[rc]   could not set it"

echo "[rc] arming the watchdog"
# The watchdog daemon starts from /etc/services, which is after this
# script finishes - so a boot that hangs partway through this file would
# hang forever, with no daemon yet to notice. This arms the hardware
# timer now and exits: nothing pets it until the daemon starts, so if we
# never get that far the board resets itself and tries again.
#
# Two minutes is deliberately generous. The first boot on a large card
# grows the filesystem, and DHCP has its own timeouts to run out.
watchdog -1 -t 120 || echo "[rc]   no hardware watchdog on this board"

echo "[rc] kernel memory reserves"
# Memory root can always get at, so an administrator still has room to
# clean up when things run dry. The default 8MB is too tight.
echo 65536 > /proc/sys/vm/admin_reserve_kbytes || echo "[rc]   failed"
# The minimum the kernel always keeps free. Too low and allocations
# start failing abruptly.
echo 16384 > /proc/sys/vm/min_free_kbytes || echo "[rc]   failed"

echo "[rc] safety net"
# Compressed swap inside RAM. Nothing is written to the card.
zram on 256 || echo "[rc]   carrying on without zram"
# One daemon watching the five things that take this board down:
#   memory   kills the largest process before the kernel has to guess,
#            and marks init/sh/dropbear/wpa_supplicant/watchdog/logd/guard
#            with oom_score_adj=-1000 so the kernel cannot take them
#   heat     holds the CPU at its lowest speed above 80C
#   power    the same, on the firmware's undervoltage flag - which is the
#            usual reason SD cards get corrupted, and is otherwise silent
#   CPU      a process holding a core for a minute goes to the back of
#            the queue, so SSH still answers
#   disk     warns before /data fills, drops the old log if it does
guard -d -r 32 -w 64 || echo "[rc]   guard did not start"

# /tmp with a ceiling on it.
#
# The root filesystem lives in RAM, and a file written there is memory
# that no process owns. guard would watch the free memory fall and start
# killing processes, and none of it would give a single page back. So
# /tmp gets its own filesystem with a limit: a program that runs away
# writing temporary files hits "no space left" - which it is written to
# handle - instead of taking the machine down with it.
mount -t tmpfs -o size=64M,nosuid,nodev tmpfs /tmp || echo "[rc]   /tmp is unbounded"

echo "[rc] storage"
# The image is 256MB, so on a larger card the rest sits unallocated.
# On the first boot we grow the partition and the filesystem to the end
# of the card.
# The card shows up under a different name depending on where we are
# running, and there is no way to ask "which disk did I boot from" with
# the tools we have. So try each in turn:
#   mmcblk0   the real board's SD card
#   vda       VirtIO - QEMU and UTM's default
#   nvme0n1   NVMe - the other interface UTM offers
#   sda       USB - a stick or an enclosure on the board, and what UTM
#             uses when the drive is attached over USB
# Only one of them exists at a time, so the failures are silent and cheap.
#
# USB comes last on purpose. It is the one that has to be waited for (-w),
# because the bus takes about a second to enumerate, and there is no point
# paying that when the card is already there.
#
# errors=remount-ro: if ext4 hits corruption it goes read-only there and
# then, rather than carrying on and writing more damage over it. The
# system stays up and reachable - the root filesystem is in RAM - so
# there is a chance to look at it.
#
# These stay on one line each: our shell has no line continuation, and a
# trailing backslash would be passed through as an argument.
expandfs || expandfs /dev/vda /dev/vda2 || expandfs /dev/nvme0n1 /dev/nvme0n1p2 || expandfs -w /dev/sda /dev/sda2 || echo "[rc]   nothing to expand"
mount -o errors=remount-ro /dev/mmcblk0p2 /data || mount -o errors=remount-ro /dev/vda2 /data || mount -o errors=remount-ro /dev/nvme0n1p2 /data || mount -o errors=remount-ro /dev/sda2 /data || echo "[rc]   no data partition - continuing in RAM"

# Somewhere for logd to write. It starts from /etc/services right
# after this script, so the directory has to exist by now.
mkdir -p /data/log

echo "[rc] restoring the clock"
# The Pi Zero 2 W has no battery-backed clock. At power-on the kernel
# clock starts at 1970. Left that way, file timestamps are nonsense and
# HTTPS fails outright because every server certificate looks like it was
# issued in the future.
# Start from the time we saved last. Not exact, but far better than 1970.
# The real time comes once the network is up.
ntp -r || echo "[rc]   no saved time (first boot)"

echo "[rc] home directory on storage"
# /root is in RAM and would vanish on reboot. Bind a directory from the
# data partition over it so whatever is saved in home stays.
mkdir -p /data/root/.ssh && mount -o bind /data/root /root || echo "[rc]   home is in RAM (lost on reboot)"
# -n: do not overwrite. A key the user put there must not be wiped by the
# empty default on every boot.
cp -n /etc/authorized_keys /root/.ssh/authorized_keys

echo "[rc] reading settings from the boot partition"
# The boot partition is FAT32, so Windows and macOS see it too. Put a
# file there from a PC and the next boot picks it up. It is the only way
# to set this machine up without a Linux box, which makes it important.
#
#   authorized_keys       SSH public key (nothing gets in without it)
#   wpa_supplicant.conf   WiFi router details
#
# -q: a missing file is normal here, so do not print an error.
#
# Mounted read-only: FAT has no journal, so a power cut while it is
# writable can lose the boot partition entirely - and with it the
# kernel. We only ever read from here, so there is nothing to give up.
mkdir -p /boot
mount -o ro /dev/mmcblk0p1 /boot || mount -o ro /dev/vda1 /boot || mount -o ro /dev/nvme0n1p1 /boot || mount -o ro /dev/sda1 /boot || echo "[rc]   could not read the boot partition"
cp -q /boot/authorized_keys /root/.ssh/authorized_keys && echo "[rc]   took the SSH public key"
cp -q /boot/wpa_supplicant.conf /data/wpa_supplicant.conf && echo "[rc]   took the WiFi settings"

echo "[rc] WiFi configuration"
# The copy on the data partition wins, so the router details can be
# changed without burning the card again.
cat /data/wpa_supplicant.conf > /etc/wpa.conf || cat /etc/wpa_supplicant.conf > /etc/wpa.conf

echo "[rc] starting WiFi"
wpa_supplicant -B -i wlan0 -c /etc/wpa.conf || echo "[rc]   carrying on without WiFi"

echo "[rc] requesting an address"
#   wlan0  WiFi
#   eth0   USB Ethernet adapter (host mode)
#   usb0   USB gadget - when plugged into a PC
dhcp wlan0 || dhcp eth0 || dhcp usb0 || echo "[rc]   got no address"

echo "[rc] setting the time"
# HTTPS depends on this. The boot carries on either way, but with the
# clock wrong Python's certificate checks will fail.
ntp || echo "[rc]   no time from the network - HTTPS certificate checks may fail"

# A user startup script. If it is on the data partition, run it.
# This is the place to add things without burning the card again.
#
# bootcount goes first, and this is the only guard against a board that
# reboots forever. A mistake in rc.local that hangs the machine would
# otherwise be fatal: the watchdog reboots, rc.local hangs it again, and
# there is never a window to log in and fix the file. So after five boots
# that did not last five minutes, bootcount fails here and the script is
# skipped - the machine comes up plain and reachable.
# (sh -q: stay quiet when the file is not there)
bootcount && sh -q /data/rc.local

echo "[rc] done (init starts SSH from /etc/services)"
